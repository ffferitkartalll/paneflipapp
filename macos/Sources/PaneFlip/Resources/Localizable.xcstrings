    "Click the field, then press any key or combination. Esc cancels." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alana tıkla, sonrasında bir ya da birden fazla tuşa bas. Esc iptal eder."
          }
        }
      }
    },
    "Click to split  ·  Hold ⇧ for a horizontal split\nDrag a line to resize  ·  Double-click a handle to remove it\nDrag a zone onto its neighbour to merge them" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayırmak için tıkla  ·  Yatay ayırma için ⇧ basılı tut\nYeniden boyutlandırmak için çizgiyi sürükle  ·  Kaldırmak için çizgideki tutacağa çift tıkla\nBölgeleri birleştirmek için komşusuna sürükle"
          }
        }
      }
    },
