    "Swipe sideways with three fingers to move through a zone's windows, and with four fingers to slide to the zones beyond the screen. No keys are needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب جانبيًا بثلاثة أصابع للتنقل بين نوافذ المنطقة، وبأربعة أصابع للانتقال إلى المناطق خارج الشاشة. لا حاجة إلى أي مفاتيح."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плъзнете настрани с три пръста, за да се движите между прозорците на зона, и с четири пръста, за да преминете към зоните извън екрана. Не са нужни клавиши."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি জোনের উইন্ডোগুলোর মধ্যে যেতে তিন আঙুলে পাশে সোয়াইপ করুন, আর স্ক্রিনের বাইরের জোনগুলোতে স্লাইড করতে চার আঙুলে। কোনো কী লাগবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca cap als costats amb tres dits per moure't entre les finestres d'una zona, i amb quatre dits per desplaçar-te a les zones més enllà de la pantalla. No calen tecles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím do strany třemi prsty se pohybujete mezi okny zóny a čtyřmi prsty přejdete do zón za okrajem obrazovky. Žádné klávesy nejsou potřeba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg sidelæns med tre fingre for at gå gennem en zones vinduer, og med fire fingre for at glide til zonerne uden for skærmen. Der skal ikke bruges taster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische mit drei Fingern zur Seite, um durch die Fenster einer Zone zu gehen, und mit vier Fingern, um zu den Zonen jenseits des Bildschirms zu gleiten. Es sind keine Tasten nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε πλευρικά με τρία δάχτυλα για να περάσετε μέσα από τα παράθυρα μιας ζώνης και με τέσσερα δάχτυλα για να γλιστρήσετε στις ζώνες πέρα από την οθόνη. Δεν χρειάζονται πλήκτρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia los lados con tres dedos para moverte entre las ventanas de una zona, y con cuatro dedos para ir a las zonas más allá de la pantalla. No hacen falta teclas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pühi kolme sõrmega küljele, et liikuda tsooni akende vahel, ja nelja sõrmega, et libiseda ekraanist kaugemale jäävatesse tsoonidesse. Klahve pole vaja."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با سه انگشت به پهلو بکشید تا میان پنجره‌های یک ناحیه حرکت کنید و با چهار انگشت تا به ناحیه‌های فراتر از صفحه بلغزید. به هیچ کلیدی نیاز نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise sivulle kolmella sormella siirtyäksesi vyöhykkeen ikkunoiden välillä ja neljällä sormella liukuaksesi näytön ulkopuolisille vyöhykkeille. Näppäimiä ei tarvita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-swipe patagilid gamit ang tatlong daliri para lumipat sa mga window ng isang zone, at gamit ang apat na daliri para mag-slide sa mga zone sa kabila ng screen. Hindi kailangan ng mga key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez latéralement avec trois doigts pour parcourir les fenêtres d'une zone, et avec quatre doigts pour glisser vers les zones au-delà de l'écran. Aucune touche n'est nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק הצידה בשלוש אצבעות כדי לעבור בין חלונות של אזור, ובארבע אצבעות כדי להחליק לאזורים שמעבר למסך. אין צורך במקשים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़ोन की विंडो के बीच जाने के लिए तीन उँगलियों से बग़ल में स्वाइप करें, और स्क्रीन के पार वाले ज़ोन तक फिसलने के लिए चार उँगलियों से। किसी कुंजी की ज़रूरत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijeđite u stranu s tri prsta za kretanje kroz prozore zone, a s četiri prsta za klizanje do zona izvan zaslona. Tipke nisu potrebne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza oldalra három ujjal, hogy végigmenjen egy zóna ablakain, négy ujjal pedig, hogy a képernyőn túli zónákra csússzon. Billentyűkre nincs szükség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke samping dengan tiga jari untuk berpindah antar jendela dalam zona, dan dengan empat jari untuk meluncur ke zona di luar layar. Tidak perlu tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri di lato con tre dita per spostarti tra le finestre di una zona e con quattro dita per passare alle zone oltre lo schermo. Non servono tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3本指で横にスワイプするとゾーン内のウインドウを移動し、4本指では画面の外にあるゾーンへスライドします。キーは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세 손가락으로 옆으로 쓸어 넘기면 영역의 윈도우 사이를 이동하고, 네 손가락으로 쓸면 화면 밖의 영역으로 미끄러지듯 이동합니다. 키는 필요 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbraukite į šalį trimis pirštais, kad judėtumėte tarp zonos langų, o keturiais – kad slystumėte į zonas už ekrano. Klavišų nereikia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velciet uz sāniem ar trim pirkstiem, lai pārvietotos starp zonas logiem, un ar četriem pirkstiem, lai slīdētu uz zonām aiz ekrāna. Taustiņi nav vajadzīgi."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झोनच्या विंडोंमध्ये फिरण्यासाठी तीन बोटांनी बाजूला स्वाइप करा आणि स्क्रीनच्या पलीकडील झोनकडे सरकण्यासाठी चार बोटांनी. कोणत्याही कळेची गरज नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke tepi dengan tiga jari untuk bergerak antara tetingkap zon, dan dengan empat jari untuk meluncur ke zon di luar skrin. Tiada kekunci diperlukan."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip sidelengs med tre fingre for å gå gjennom vinduene i en sone, og med fire fingre for å gli til sonene utenfor skjermen. Du trenger ingen taster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg met drie vingers opzij om door de vensters van een zone te gaan, en met vier vingers om naar de zones voorbij het scherm te glijden. Toetsen zijn niet nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń trzema palcami w bok, aby przechodzić między oknami strefy, a czterema palcami, aby przesunąć się do stref poza ekranem. Klawisze nie są potrzebne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para o lado com três dedos para percorrer as janelas de uma zona e com quatro dedos para ir para as zonas além do ecrã. Não são precisas teclas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para o lado com três dedos para percorrer as janelas de uma zona e com quatro dedos para ir às zonas além da tela. Não são necessárias teclas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisează lateral cu trei degete pentru a trece prin ferestrele unei zone și cu patru degete pentru a aluneca spre zonele din afara ecranului. Nu sunt necesare taste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите тремя пальцами в сторону, чтобы переходить между окнами зоны, и четырьмя пальцами, чтобы скользить к зонам за пределами экрана. Клавиши не нужны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím do strany tromi prstami sa pohybujete medzi oknami zóny a štyrmi prstami sa presuniete do zón za okrajom obrazovky. Klávesy nie sú potrebné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tremi prsti podrsnite vstran, da se premikate med okni cone, s štirimi prsti pa, da zdrsnete na cone zunaj zaslona. Tipke niso potrebne."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превуците бочно са три прста да бисте прелазили између прозора зоне, а са четири прста да бисте клизили до зона изван екрана. Тастери нису потребни."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt sidan med tre fingrar för att gå igenom fönstren i en zon, och med fyra fingrar för att glida till zonerna bortom skärmen. Inga tangenter behövs."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மண்டலத்தின் சாளரங்களுக்கிடையே செல்ல மூன்று விரல்களால் பக்கவாட்டில் ஸ்வைப் செய்யவும்; திரைக்கு அப்பால் உள்ள மண்டலங்களுக்கு நகர நான்கு விரல்களால் செய்யவும். விசைகள் தேவையில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జోన్‌లోని విండోల మధ్య వెళ్లడానికి మూడు వేళ్లతో పక్కకు స్వైప్ చేయండి, స్క్రీన్ అవతల ఉన్న జోన్‌లకు జారడానికి నాలుగు వేళ్లతో చేయండి. కీలు అవసరం లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดไปด้านข้างด้วยสามนิ้วเพื่อเลื่อนผ่านหน้าต่างของโซน และด้วยสี่นิ้วเพื่อเลื่อนไปยังโซนที่อยู่นอกหน้าจอ ไม่ต้องใช้ปุ่มใด ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölgenin pencereleri arasında gezinmek için üç parmakla yana kaydırın, ekranın ötesindeki bölgelere geçmek için dört parmakla kaydırın. Tuşlara gerek yoktur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть трьома пальцями вбік, щоб переходити між вікнами зони, і чотирма пальцями, щоб ковзати до зон за межами екрана. Клавіші не потрібні."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زون کی ونڈوز کے درمیان جانے کے لیے تین انگلیوں سے پہلو کی طرف سوائپ کریں، اور اسکرین سے پرے زونز تک پھسلنے کے لیے چار انگلیوں سے۔ کسی کی کی ضرورت نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt ngang bằng ba ngón tay để chuyển giữa các cửa sổ của vùng, và bằng bốn ngón tay để trượt tới các vùng nằm ngoài màn hình. Không cần phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用三指向侧面轻扫，可在区域的窗口之间切换；用四指轻扫，可滑到屏幕之外的区域。无需按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用三指向側面輕掃，可在區域的視窗之間切換；用四指輕掃，可滑到螢幕之外的區域。無需按鍵。"
          }
        }
      }
    },
