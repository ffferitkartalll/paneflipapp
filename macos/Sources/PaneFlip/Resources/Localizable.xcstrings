          "stringUnit" : {
            "state" : "translated",
            "value" : "மண்டலங்களுக்கு இடையில் மட்டுமே பொருந்தும், திரை விளிம்புகளில் ஒருபோதும் இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జోన్‌ల మధ్య మాత్రమే వర్తిస్తుంది, స్క్రీన్ అంచుల వద్ద ఎప్పుడూ కాదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เฉพาะระหว่างโซน ไม่ใช้ที่ขอบหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece bölgelerin arasına uygulanır, ekran kenarlarına asla uygulanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовується лише між зонами, ніколи по краях екрана."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف زونز کے درمیان لاگو ہوتا ہے، اسکرین کے کناروں پر کبھی نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ áp dụng giữa các vùng, không bao giờ ở mép màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅应用于区域之间，不会应用于屏幕边缘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅套用於區域之間，不會套用於螢幕邊緣。"
          }
        }
      }
    },
