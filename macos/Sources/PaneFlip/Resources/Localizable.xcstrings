    "Past the last zone on the screen, the focus goes on to the zones beyond its edge, and the layout scrolls to them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد آخر منطقة على الشاشة ينتقل التركيز إلى المناطق خارج حافتها، ويتمرّر التخطيط إليها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След последната зона на екрана фокусът продължава към зоните извън ръба му, а оформлението се превърта към тях."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিনের শেষ জোনের পরে ফোকাস প্রান্তের বাইরের জোনে যায়, আর লেআউট সেগুলোর দিকে স্ক্রল করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passada l'última zona de la pantalla, el focus continua cap a les zones fora de la seva vora, i la disposició es desplaça cap a elles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za poslední zónou na obrazovce pokračuje fokus do zón za jejím okrajem a rozložení se k nim posune."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter den sidste zone på skærmen går fokus videre til zonerne uden for dens kant, og layoutet ruller hen til dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der letzten Zone auf dem Bildschirm geht der Fokus zu den Zonen jenseits des Rands, und das Layout scrollt zu ihnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά την τελευταία ζώνη στην οθόνη, η εστίαση συνεχίζει στις ζώνες πέρα από το άκρο της και η διάταξη κυλά προς αυτές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasada la última zona de la pantalla, el foco sigue hacia las zonas más allá de su borde y la disposición se desplaza hacia ellas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pärast ekraani viimast tsooni liigub fookus servast kaugemale jäävatesse tsoonidesse ja paigutus kerib nende juurde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از آخرین ناحیه روی صفحه‌نمایش، تمرکز به ناحیه‌های فراتر از لبهٔ آن می‌رود و چیدمان به سمت آن‌ها پیمایش می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytön viimeisen alueen jälkeen kohdistus jatkaa reunan taakse jääville alueille, ja asettelu vierittyy niiden luo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkatapos ng huling zone sa screen, nagpapatuloy ang focus sa mga zone sa labas ng gilid nito, at nag-i-scroll ang layout papunta sa mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la dernière zone de l'écran, le focus continue vers les zones au-delà de son bord, et la disposition défile jusqu'à elles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי האזור האחרון במסך המיקוד ממשיך לאזורים מעבר לקצה שלו, והפריסה גוללת אליהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन के आख़िरी ज़ोन के बाद फ़ोकस उसके किनारे के पार के ज़ोन में जाता है और लेआउट उनकी ओर स्क्रोल होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon posljednje zone na zaslonu fokus ide dalje na zone izvan njegova ruba, a raspored se pomiče prema njima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyő utolsó zónája után a fókusz a szélén túli zónákra megy tovább, és az elrendezés odagörög."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah zona terakhir di layar, fokus berlanjut ke zona di luar tepinya, dan tata letak bergulir ke sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo l'ultima zona sullo schermo, il focus prosegue verso le zone oltre il suo bordo e il layout scorre fino a loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上の最後のゾーンの先では、フォーカスが端の外にあるゾーンへ進み、レイアウトがそこへスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면의 마지막 영역을 지나면 포커스가 가장자리 밖의 영역으로 이어지고, 레이아웃이 그쪽으로 스크롤됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po paskutinės ekrano zonos fokusas pereina į zonas už jo krašto, o išdėstymas slenka link jų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pēc pēdējās zonas ekrānā fokuss turpina uz zonām aiz tā malas, un izkārtojums ritinās uz tām."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीनवरील शेवटच्या झोननंतर फोकस त्याच्या कडेपलीकडील झोनमध्ये जातो आणि लेआउट त्यांच्याकडे स्क्रोल होतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas zon terakhir pada skrin, fokus diteruskan ke zon di luar tepinya, dan reka letak menatal ke sana."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter den siste sonen på skjermen går fokus videre til sonene utenfor kanten, og oppsettet ruller til dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorbij de laatste zone op het scherm gaat de focus verder naar de zones voorbij de rand, en de indeling scrolt ernaartoe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za ostatnią strefą na ekranie fokus przechodzi do stref poza jego krawędzią, a układ przewija się do nich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois da última zona do ecrã, o foco continua para as zonas além da sua margem e a disposição desloca-se até elas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois da última zona da tela, o foco continua para as zonas além da sua borda e o layout rola até elas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După ultima zonă de pe ecran, focalizarea merge mai departe spre zonele de dincolo de margine, iar aspectul derulează spre ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После последней зоны на экране фокус переходит в зоны за его краем, а раскладка прокручивается к ним."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za poslednou zónou na obrazovke pokračuje fokus do zón za jej okrajom a rozloženie sa k nim posunie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za zadnjim območjem na zaslonu gre fokus naprej na območja zunaj njegovega roba, postavitev pa se pomakne do njih."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После последње зоне на екрану фокус иде даље на зоне изван његове ивице, а распоред се помера ка њима."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter den sista zonen på skärmen går fokus vidare till zonerna utanför kanten, och layouten rullar till dem."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திரையின் கடைசி மண்டலத்துக்குப் பிறகு கவனம் அதன் விளிம்புக்கு அப்பால் உள்ள மண்டலங்களுக்குச் செல்லும், தளவமைப்பு அவற்றை நோக்கி உருளும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్క్రీన్‌పై చివరి జోన్ తర్వాత ఫోకస్ దాని అంచుకు ఆవల ఉన్న జోన్‌లకు వెళ్తుంది, లేఅవుట్ వాటి వైపు స్క్రోల్ అవుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังโซนสุดท้ายบนหน้าจอ โฟกัสจะไปต่อยังโซนที่อยู่นอกขอบ และเลย์เอาต์จะเลื่อนไปหาโซนเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrandaki son bölgeden sonra odak, kenarın ötesindeki bölgelere geçer ve düzen onlara kayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після останньої зони на екрані фокус переходить до зон за його краєм, а розкладка прокручується до них."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین کے آخری زون کے بعد فوکس اس کے کنارے سے آگے کے زونز میں جاتا ہے اور لے آؤٹ ان کی طرف اسکرول ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau vùng cuối cùng trên màn hình, tiêu điểm tiếp tục sang các vùng ngoài mép, và bố cục cuộn tới đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越过屏幕上的最后一个区域后，焦点会继续移到边缘之外的区域，布局会滚动到那里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
