    "You changed the app language, so you need to restart PaneFlip for the change to take effect." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد غيّرت لغة التطبيق، لذا عليك إعادة تشغيل PaneFlip لكي يسري التغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Променихте езика на приложението, затова трябва да рестартирате PaneFlip, за да влезе в сила промяната."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অ্যাপের ভাষা পরিবর্তন করেছেন, তাই পরিবর্তন কার্যকর হতে PaneFlip রিস্টার্ট করতে হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has canviat l’idioma de l’app, així que cal reiniciar PaneFlip perquè el canvi tingui efecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změnili jste jazyk aplikace, takže je třeba PaneFlip restartovat, aby se změna projevila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ændret appens sprog, så du skal genstarte PaneFlip, for at ændringen træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die App-Sprache geändert. Starte PaneFlip neu, damit die Änderung wirksam wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάξατε τη γλώσσα της εφαρμογής, επομένως πρέπει να κάνετε επανεκκίνηση του PaneFlip για να ισχύσει η αλλαγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has cambiado el idioma de la app, así que debes reiniciar PaneFlip para que el cambio surta efecto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutsite rakenduse keelt, seega peate muudatuse jõustumiseks PaneFlipi taaskäivitama."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان برنامه را تغییر دادید، بنابراین برای اعمال تغییر باید PaneFlip را دوباره راه‌اندازی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihdoit sovelluksen kielen, joten PaneFlip on käynnistettävä uudelleen, jotta muutos tulee voimaan."
