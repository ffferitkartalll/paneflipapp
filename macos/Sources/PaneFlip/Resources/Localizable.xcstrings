    "Lets PaneFlip see the windows of other apps and move them into zones." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لـ PaneFlip رؤية نوافذ التطبيقات الأخرى ونقلها إلى المناطق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на PaneFlip да вижда прозорците на други приложения и да ги премества в зони."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip-কে অন্য অ্যাপের উইন্ডো দেখতে এবং সেগুলোকে জোনে সরাতে দেয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que PaneFlip vegi les finestres d’altres apps i les mogui a zones."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip vidět okna jiných aplikací a přesouvat je do zón."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader PaneFlip se andre apps’ vinduer og flytte dem ind i zoner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt PaneFlip, die Fenster anderer Apps zu sehen und in Zonen zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στο PaneFlip να βλέπει τα παράθυρα άλλων εφαρμογών και να τα μετακινεί σε ζώνες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a PaneFlip ver las ventanas de otras apps y moverlas a zonas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võimaldab PaneFlipil näha teiste rakenduste aknaid ja liigutada neid tsoonidesse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به PaneFlip اجازه می‌دهد پنجره‌های برنامه‌های دیگر را ببیند و آن‌ها را به ناحیه‌ها منتقل کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa PaneFlipin nähdä muiden sovellusten ikkunat ja siirtää ne alueisiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapayagan ang PaneFlip na makita ang mga window ng ibang app at ilipat ang mga ito sa mga zone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à PaneFlip de voir les fenêtres des autres apps et de les déplacer dans des zones."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר ל-PaneFlip לראות את החלונות של אפליקציות אחרות ולהעביר אותם לאזורים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip को अन्य ऐप्स की विंडो देखने और उन्हें ज़ोन में ले जाने देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje PaneFlipu da vidi prozore drugih aplikacija i premjesti ih u zone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi, hogy a PaneFlip lássa más alkalmazások ablakait, és zónákba helyezze őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengizinkan PaneFlip melihat jendela app lain dan memindahkannya ke zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a PaneFlip di vedere le finestre delle altre app e di spostarle nelle zone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlipが他のアプリのウインドウを認識し、ゾーンに移動できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip이 다른 앱의 윈도우를 확인하고 영역으로 이동할 수 있도록 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leidžia PaneFlip matyti kitų programų langus ir perkelti juos į zonas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļauj PaneFlip redzēt citu lietotņu logus un pārvietot tos zonās."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip ला इतर अ‍ॅप्सच्या विंडो पाहू आणि त्या झोनमध्ये हलवू देते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membenarkan PaneFlip melihat tetingkap app lain dan mengalihkannya ke dalam zon."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar PaneFlip se andre apper sine vinduer og flytte dem inn i soner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat PaneFlip de vensters van andere apps zien en ze naar zones verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala PaneFlip widzieć okna innych aplikacji i przenosić je do stref."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o PaneFlip veja as janelas de outras apps e as mova para zonas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o PaneFlip veja as janelas de outros apps e as mova para zonas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite PaneFlip să vadă ferestrele altor aplicații și să le mute în zone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет PaneFlip видеть окна других приложений и перемещать их в зоны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip vidieť okná iných aplikácií a presúvať ich do zón."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoča PaneFlipu, da vidi okna drugih aplikacij in jih premakne v območja."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућава PaneFlip-у да види прозоре других апликација и премести их у зоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter PaneFlip se andra appars fönster och flytta dem till zoner."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிற பயன்பாடுகளின் சாளரங்களைப் பார்க்கவும் அவற்றை மண்டலங்களுக்கு நகர்த்தவும் PaneFlip-ஐ அனுமதிக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇతర యాప్‌ల విండోలను చూడటానికి మరియు వాటిని జోన్‌లలోకి తరలించడానికి PaneFlip‌ను అనుమతిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ PaneFlip เห็นหน้าต่างของแอปอื่นและย้ายไปยังโซน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip'in diğer uygulamaların pencerelerini görmesine ve bölgelere ekleyebilmesine olanak sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє PaneFlip бачити вікна інших програм і переміщувати їх у зони."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip کو دوسری ایپس کی ونڈوز دیکھنے اور انہیں زونز میں منتقل کرنے دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép PaneFlip xem cửa sổ của các ứng dụng khác và di chuyển chúng vào các vùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 PaneFlip 查看其他 App 的窗口并将其移入区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 PaneFlip 查看其他 App 的視窗並將其移入區域。"
          }
        }
      }
    },
    "Lets PaneFlip take a picture of a window, so it can slide in beside another one inside its zone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لـ PaneFlip التقاط صورة لنافذة، ليتمكن من تمريرها بجانب نافذة أخرى داخل منطقتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на PaneFlip да прави снимка на прозорец, за да може той да се плъзне до друг прозорец в рамките на своята зона."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip-কে একটি উইন্ডোর ছবি তুলতে দেয়, যাতে সেটি তার জোনের ভেতরে অন্য একটি উইন্ডোর পাশে স্লাইড করে আসতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que PaneFlip faci una captura d’una finestra, perquè pugui lliscar al costat d’una altra dins de la seva zona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip pořídit snímek okna, aby se mohlo vsunout vedle jiného okna uvnitř své zóny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader PaneFlip tage et billede af et vindue, så det kan glide ind ved siden af et andet inden for sin zone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt PaneFlip, ein Bild eines Fensters aufzunehmen, damit es innerhalb seiner Zone neben ein anderes gleiten kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στο PaneFlip να τραβά μια εικόνα ενός παραθύρου, ώστε να γλιστρά δίπλα σε ένα άλλο μέσα στη ζώνη του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a PaneFlip hacer una captura de una ventana para que pueda deslizarse junto a otra dentro de su zona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võimaldab PaneFlipil teha aknast pildi, et see saaks oma tsoonis teise akna kõrvale libiseda."
