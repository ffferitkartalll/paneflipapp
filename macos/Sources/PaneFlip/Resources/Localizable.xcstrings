    "Hold the scroll keys (set in the Shortcuts tab) and scroll with two fingers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط باستمرار على مفاتيح التمرير (يتم ضبطها في علامة تبويب الاختصارات) ومرّر بإصبعين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте клавишите за превъртане (задават се в раздел „Клавишни комбинации“) и превъртайте с два пръста."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রল কীগুলো চেপে ধরুন (শর্টকাট ট্যাবে সেট করা হয়) এবং দুই আঙুল দিয়ে স্ক্রল করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premudes les tecles de desplaçament (es defineixen a la pestanya Dreceres) i desplaça't amb dos dits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte klávesy pro posouvání (nastavují se na kartě Zkratky) a posouvejte dvěma prsty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold rulletasterne nede (indstilles under Genveje) og rul med to fingre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Scroll-Tasten gedrückt (im Tab „Tastenkürzel“ festgelegt) und scrolle mit zwei Fingern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένα τα πλήκτρα κύλισης (ορίζονται στην καρτέλα Συντομεύσεις) και κάντε κύλιση με δύο δάχτυλα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas las teclas de desplazamiento (se definen en la pestaña Atajos) y desplázate con dos dedos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia all kerimisklahve (need määratakse vahekaardil Kiirklahvid) ja keri kahe sõrmega."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلیدهای پیمایش را نگه دارید (در زبانهٔ میان‌برها تنظیم می‌شوند) و با دو انگشت پیمایش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä vierityspainikkeita painettuna (ne asetetaan Pikanäppäimet-välilehdellä) ja vieritä kahdella sormella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal ang mga scroll key (itinatakda sa tab na Mga shortcut) at mag-scroll gamit ang dalawang daliri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez les touches de défilement (définies dans l'onglet Raccourcis) et faites défiler avec deux doigts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזק את מקשי הגלילה (מוגדרים בלשונית קיצורי דרך) וגלול בשתי אצבעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रोल कुंजियाँ दबाए रखें (शॉर्टकट टैब में तय होती हैं) और दो उँगलियों से स्क्रोल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite tipke za pomicanje (postavljaju se na kartici Prečaci) i pomičite s dva prsta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa lenyomva a görgetési billentyűket (a Billentyűparancsok lapon állíthatók be), és görgessen két ujjal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol gulir (diatur di tab Pintasan) dan gulir dengan dua jari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuti i tasti di scorrimento (si impostano nella scheda Scorciatoie) e scorri con due dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロール用のキー（「ショートカット」タブで設定）を押したまま、2本指でスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 키(단축키 탭에서 설정)를 누른 채 두 손가락으로 스크롤하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laikykite nuspaudę slinkimo klavišus (nustatomi skirtuke „Spartieji klavišai“) ir slinkite dviem pirštais."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turiet nospiestus ritināšanas taustiņus (tos iestata cilnē Īsinājumtaustiņi) un ritiniet ar diviem pirkstiem."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रोल कळा दाबून ठेवा (शॉर्टकट टॅबमध्ये ठरवल्या जातात) आणि दोन बोटांनी स्क्रोल करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan kekunci tatal (ditetapkan dalam tab Pintasan) dan tatal dengan dua jari."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold rulletastene nede (angis i fanen Snarveier) og rull med to fingre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de scrolltoetsen ingedrukt (in te stellen op het tabblad Sneltoetsen) en scrol met twee vingers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj klawisze przewijania (ustawiane na karcie Skróty) i przewijaj dwoma palcami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premidas as teclas de deslocamento (definidas no separador Atalhos) e desloque com dois dedos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionadas as teclas de rolagem (definidas na aba Atalhos) e role com dois dedos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsate tastele de derulare (se stabilesc în fila Comenzi rapide) și derulează cu două degete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте клавиши прокрутки (задаются на вкладке «Сочетания клавиш») и прокручивайте двумя пальцами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte klávesy na posúvanie (nastavujú sa na karte Skratky) a posúvajte dvoma prstami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite tipke za drsenje (nastavijo se na zavihku Bližnjice) in drsite z dvema prstoma."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Држите тастере за померање (подешавају се на картици Пречице) и померајте са два прста."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned rulltangenterna (ställs in på fliken Kortkommandon) och rulla med två fingrar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உருட்டல் விசைகளை அழுத்திப் பிடித்து (குறுக்குவழிகள் தாவலில் அமைக்கப்படும்) இரண்டு விரல்களால் உருட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్క్రోల్ కీలను నొక్కి పట్టుకోండి (షార్ట్‌కట్‌లు ట్యాబ్‌లో సెట్ చేయబడతాయి) మరియు రెండు వేళ్లతో స్క్రోల్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดปุ่มเลื่อนค้างไว้ (ตั้งค่าในแท็บทางลัด) แล้วเลื่อนด้วยสองนิ้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırma tuşlarını basılı tutun (Kısayollar sekmesinde ayarlanır) ve iki parmakla kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте клавіші прокручування (задаються на вкладці «Скорочення») і прокручуйте двома пальцями."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرول کیز دبائے رکھیں (شارٹ کٹس ٹیب میں سیٹ کی جاتی ہیں) اور دو انگلیوں سے اسکرول کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ các phím cuộn (đặt trong tab Phím tắt) và cuộn bằng hai ngón tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住滚动按键（在“快捷键”标签页中设置），然后用两指滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住捲動按鍵（在「快速鍵」標籤頁中設定），然後用兩指捲動。"
          }
        }
      }
    },
    "Hold these keys and scroll over a zone with the mouse wheel to move through its windows. Two fingers do it too when Keys and two fingers is chosen in the Trackpad tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط باستمرار على هذه المفاتيح ومرّر فوق منطقة بعجلة الماوس للتنقل بين نوافذها. يعمل الإصبعان أيضًا عند اختيار «المفاتيح وإصبعان» في علامة تبويب لوحة التتبع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте тези клавиши и превъртайте над зона с колелцето на мишката, за да се движите между прозорците ѝ. Това става и с два пръста, когато в раздел „Тракпад“ е избрано „Клавиши и два пръста“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কীগুলো চেপে ধরে মাউসের চাকা দিয়ে একটি জোনের ওপর স্ক্রল করলে তার উইন্ডোগুলোর মধ্যে যাওয়া যায়। ট্র্যাকপ্যাড ট্যাবে “কী ও দুই আঙুল” বেছে নিলে দুই আঙুলেও এটি হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premudes aquestes tecles i desplaça't per sobre d'una zona amb la roda del ratolí per moure't entre les seves finestres. Amb dos dits també funciona si a la pestanya Trackpad està triat «Tecles i dos dits»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte tyto klávesy a kolečkem myši posouvejte nad zónou, abyste procházeli její okna. Dvěma prsty to funguje také, když je na kartě Trackpad zvoleno „Klávesy a dva prsty“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold disse taster nede, og rul over en zone med musehjulet for at gå gennem dens vinduer. To fingre virker også, når „Taster og to fingre“ er valgt under Pegefelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte diese Tasten gedrückt und scrolle mit dem Mausrad über einer Zone, um durch ihre Fenster zu gehen. Zwei Finger funktionieren ebenfalls, wenn im Tab „Trackpad“ „Tasten und zwei Finger“ gewählt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένα αυτά τα πλήκτρα και κάντε κύλιση πάνω από μια ζώνη με τον τροχό του ποντικιού για να περάσετε στα παράθυρά της. Λειτουργεί και με δύο δάχτυλα όταν στην καρτέλα Trackpad είναι επιλεγμένο «Πλήκτρα και δύο δάχτυλα»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas estas teclas y desplázate sobre una zona con la rueda del ratón para moverte entre sus ventanas. Con dos dedos también funciona si en la pestaña Trackpad está elegido «Teclas y dos dedos»."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia neid klahve all ja keri hiirerattaga tsooni kohal, et liikuda selle akende vahel. Kahe sõrmega töötab see samuti, kui vahekaardil Puuteplaat on valitud „Klahvid ja kaks sõrme“."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کلیدها را نگه دارید و با چرخ ماوس روی یک ناحیه پیمایش کنید تا میان پنجره‌هایش حرکت کنید. وقتی در زبانهٔ تاچ‌پد «کلیدها و دو انگشت» انتخاب شده باشد، دو انگشت هم همین کار را می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä näitä näppäimiä painettuna ja vieritä vyöhykkeen päällä hiiren rullalla siirtyäksesi sen ikkunoiden välillä. Kaksi sormea toimii myös, kun Ohjauslevy-välilehdellä on valittuna ”Näppäimet ja kaksi sormea”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal ang mga key na ito at mag-scroll sa ibabaw ng isang zone gamit ang gulong ng mouse para lumipat sa mga window nito. Gumagana rin ito gamit ang dalawang daliri kapag napili ang “Mga key at dalawang daliri” sa tab na Trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ces touches et faites défiler au-dessus d'une zone avec la molette de la souris pour parcourir ses fenêtres. Deux doigts le font aussi lorsque « Touches et deux doigts » est choisi dans l'onglet Trackpad."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזק את המקשים האלה וגלול מעל אזור בגלגלת העכבר כדי לעבור בין החלונות שלו. שתי אצבעות עושות זאת גם כאשר בלשונית משטח עקיבה נבחר ”מקשים ושתי אצבעות“."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन कुंजियों को दबाए रखें और माउस व्हील से किसी ज़ोन के ऊपर स्क्रोल करके उसकी विंडो के बीच जाएँ। ट्रैकपैड टैब में “कुंजियाँ और दो उँगलियाँ” चुना हो तो दो उँगलियाँ भी यही करती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite ove tipke i pomičite kotačićem miša iznad zone za kretanje kroz njezine prozore. S dva prsta to također radi kada je na kartici Trackpad odabrano „Tipke i dva prsta“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa lenyomva ezeket a billentyűket, és görgessen az egérkerékkel egy zóna fölött, hogy végigmenjen az ablakain. Két ujjal is működik, ha a Trackpad lapon a „Billentyűk és két ujj” van kiválasztva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol ini dan gulir di atas zona dengan roda mouse untuk berpindah antar jendelanya. Dua jari juga bisa saat “Tombol dan dua jari” dipilih di tab Trackpad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuti questi tasti e scorri sopra una zona con la rotellina del mouse per spostarti tra le sue finestre. Funziona anche con due dita quando nella scheda Trackpad è scelto «Tasti e due dita»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのキーを押したまま、ゾーンの上でマウスホイールをスクロールすると、そのウインドウを移動できます。「トラックパッド」タブで「キーと2本指」を選んでいる場合は、2本指でも同様に操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키를 누른 채 영역 위에서 마우스 휠로 스크롤하면 그 영역의 윈도우 사이를 이동합니다. 트랙패드 탭에서 “키와 두 손가락”를 선택하면 두 손가락으로도 할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laikykite nuspaudę šiuos klavišus ir pelės ratuku slinkite virš zonos, kad judėtumėte tarp jos langų. Dviem pirštais tai veikia, kai skirtuke „Jutiklinė planšetė“ pasirinkta „Klavišai ir du pirštai“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turiet nospiestus šos taustiņus un ritiniet virs zonas ar peles ritenīti, lai pārvietotos starp tās logiem. Ar diviem pirkstiem tas darbojas arī tad, ja cilnē Skārienpaliktnis izvēlēts „Taustiņi un divi pirksti”."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या कळा दाबून ठेवा आणि माउस व्हीलने झोनवर स्क्रोल करून त्याच्या विंडोंमध्ये फिरा. ट्रॅकपॅड टॅबमध्ये “कळा आणि दोन बोटे” निवडले असल्यास दोन बोटेही हेच करतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan kekunci ini dan tatal di atas zon dengan roda tetikus untuk bergerak antara tetingkapnya. Dua jari juga boleh apabila “Kekunci dan dua jari” dipilih dalam tab Pad jejak."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold disse tastene nede og rull over en sone med musehjulet for å gå gjennom vinduene. To fingre fungerer også når «Taster og to fingre» er valgt i fanen Styreflate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd deze toetsen ingedrukt en scrol met het muiswiel over een zone om door de vensters ervan te gaan. Twee vingers werken ook als op het tabblad Trackpad ‘Toetsen en twee vingers’ is gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj te klawisze i przewijaj kółkiem myszy nad strefą, aby przechodzić między jej oknami. Dwa palce też działają, gdy na karcie Gładzik wybrano „Klawisze i dwa palce”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premidas estas teclas e desloque sobre uma zona com a roda do rato para percorrer as suas janelas. Com dois dedos também funciona quando está escolhido «Teclas e dois dedos» no separador Trackpad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionadas estas teclas e role sobre uma zona com a roda do mouse para percorrer as janelas dela. Com dois dedos também funciona quando “Teclas e dois dedos” está escolhido na aba Trackpad."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsate aceste taste și derulează deasupra unei zone cu rotița mouse-ului pentru a trece prin ferestrele ei. Merge și cu două degete când în fila Trackpad este aleasă opțiunea „Taste și două degete”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте эти клавиши и прокручивайте колесиком мыши над зоной, чтобы переходить между её окнами. Двумя пальцами это тоже работает, если на вкладке «Трекпад» выбрано «Клавиши и два пальца»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte tieto klávesy a kolieskom myši posúvajte nad zónou, aby ste prechádzali jej oknami. Dvoma prstami to funguje aj vtedy, keď je na karte Trackpad zvolené „Klávesy a dva prsty“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite te tipke in z miškinim kolescem drsite nad cono, da se premikate med njenimi okni. Z dvema prstoma deluje tudi, ko je na zavihku Sledilna ploščica izbrano »Tipke in dva prsta«."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Држите ове тастере и померајте точкићем миша изнад зоне да бисте прелазили између њених прозора. Са два прста то такође ради када је на картици Трекпед изабрано „Тастери и два прста“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned de här tangenterna och rulla med mushjulet över en zon för att gå igenom dess fönster. Två fingrar fungerar också när ”Tangenter och två fingrar” är valt på fliken Styrplatta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த விசைகளை அழுத்திப் பிடித்து, மவுஸ் சக்கரத்தால் ஒரு மண்டலத்தின் மேல் உருட்டினால் அதன் சாளரங்களுக்கிடையே செல்லலாம். டிராக்பேட் தாவலில் “விசைகள் மற்றும் இரண்டு விரல்கள்” தேர்ந்தெடுக்கப்பட்டிருந்தால் இரண்டு விரல்களும் இதையே செய்யும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ కీలను నొక్కి పట్టుకుని, మౌస్ వీల్‌తో జోన్ పైన స్క్రోల్ చేస్తే దాని విండోల మధ్య వెళ్లవచ్చు. ట్రాక్‌ప్యాడ్ ట్యాబ్‌లో “కీలు మరియు రెండు వేళ్లు” ఎంచుకుంటే రెండు వేళ్లు కూడా ఇదే చేస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดปุ่มเหล่านี้ค้างไว้แล้วเลื่อนลูกกลิ้งเมาส์เหนือโซนเพื่อเลื่อนผ่านหน้าต่างของโซนนั้น สองนิ้วก็ใช้ได้เช่นกันเมื่อเลือก “ปุ่มและสองนิ้ว” ในแท็บแทร็กแพด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tuşları basılı tutup fare tekerleğiyle bir bölgenin üzerinde kaydırarak pencereleri arasında gezinin. İzleme dörtgeni sekmesinde “Tuşlar ve iki parmak” seçiliyse iki parmak da aynısını yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте ці клавіші та прокручуйте коліщатком миші над зоною, щоб переходити між її вікнами. Двома пальцями це теж працює, якщо на вкладці «Трекпад» вибрано «Клавіші та два пальці»."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کیز کو دبائے رکھیں اور ماؤس وہیل سے کسی زون کے اوپر اسکرول کر کے اس کی ونڈوز کے درمیان جائیں۔ ٹریک پیڈ ٹیب میں “کیز اور دو انگلیاں” منتخب ہو تو دو انگلیاں بھی یہی کرتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ các phím này và cuộn bằng con lăn chuột phía trên một vùng để chuyển giữa các cửa sổ của vùng đó. Hai ngón tay cũng làm được khi chọn “Phím và hai ngón tay” trong tab Bàn di chuột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住这些按键，用鼠标滚轮在区域上方滚动，即可在其窗口之间切换。在“触控板”标签页中选择“按键和两指”时，两指也可以这样操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住這些按鍵，用滑鼠滾輪在區域上方捲動，即可在其視窗之間切換。在「觸控式軌跡板」標籤頁中選擇「按鍵和兩指」時，兩指也可以這樣操作。"
          }
        }
      }
    },
    "Hold these keys and scroll over the screen with the mouse wheel to slide to the zones beyond its edges. Two fingers do it too when Keys and two fingers is chosen in the Trackpad tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط باستمرار على هذه المفاتيح ومرّر فوق الشاشة بعجلة الماوس للانتقال إلى المناطق خارج حدودها. يعمل الإصبعان أيضًا عند اختيار «المفاتيح وإصبعان» في علامة تبويب لوحة التتبع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте тези клавиши и превъртайте над екрана с колелцето на мишката, за да преминете към зоните извън краищата му. Това става и с два пръста, когато в раздел „Тракпад“ е избрано „Клавиши и два пръста“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কীগুলো চেপে ধরে মাউসের চাকা দিয়ে স্ক্রিনের ওপর স্ক্রল করলে এর প্রান্তের বাইরের জোনগুলোতে স্লাইড করা যায়। ট্র্যাকপ্যাড ট্যাবে “কী ও দুই আঙুল” বেছে নিলে দুই আঙুলেও এটি হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premudes aquestes tecles i desplaça't per sobre de la pantalla amb la roda del ratolí per anar a les zones més enllà dels seus límits. Amb dos dits també funciona si a la pestanya Trackpad està triat «Tecles i dos dits»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte tyto klávesy a kolečkem myši posouvejte nad obrazovkou, abyste přešli do zón za jejími okraji. Dvěma prsty to funguje také, když je na kartě Trackpad zvoleno „Klávesy a dva prsty“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold disse taster nede, og rul over skærmen med musehjulet for at glide til zonerne uden for dens kanter. To fingre virker også, når „Taster og to fingre“ er valgt under Pegefelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte diese Tasten gedrückt und scrolle mit dem Mausrad über dem Bildschirm, um zu den Zonen jenseits seiner Ränder zu gleiten. Zwei Finger funktionieren ebenfalls, wenn im Tab „Trackpad“ „Tasten und zwei Finger“ gewählt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένα αυτά τα πλήκτρα και κάντε κύλιση πάνω από την οθόνη με τον τροχό του ποντικιού για να γλιστρήσετε στις ζώνες πέρα από τα άκρα της. Λειτουργεί και με δύο δάχτυλα όταν στην καρτέλα Trackpad είναι επιλεγμένο «Πλήκτρα και δύο δάχτυλα»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas estas teclas y desplázate sobre la pantalla con la rueda del ratón para ir a las zonas más allá de sus bordes. Con dos dedos también funciona si en la pestaña Trackpad está elegido «Teclas y dos dedos»."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia neid klahve all ja keri hiirerattaga ekraani kohal, et libiseda selle servadest kaugemale jäävatesse tsoonidesse. Kahe sõrmega töötab see samuti, kui vahekaardil Puuteplaat on valitud „Klahvid ja kaks sõrme“."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کلیدها را نگه دارید و با چرخ ماوس روی صفحه پیمایش کنید تا به ناحیه‌های فراتر از لبه‌هایش بلغزید. وقتی در زبانهٔ تاچ‌پد «کلیدها و دو انگشت» انتخاب شده باشد، دو انگشت هم همین کار را می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä näitä näppäimiä painettuna ja vieritä näytön päällä hiiren rullalla liukuaksesi sen reunojen ulkopuolisille vyöhykkeille. Kaksi sormea toimii myös, kun Ohjauslevy-välilehdellä on valittuna ”Näppäimet ja kaksi sormea”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindutin nang matagal ang mga key na ito at mag-scroll sa ibabaw ng screen gamit ang gulong ng mouse para mag-slide sa mga zone sa kabila ng mga gilid nito. Gumagana rin ito gamit ang dalawang daliri kapag napili ang “Mga key at dalawang daliri” sa tab na Trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ces touches et faites défiler au-dessus de l'écran avec la molette de la souris pour glisser vers les zones au-delà de ses bords. Deux doigts le font aussi lorsque « Touches et deux doigts » est choisi dans l'onglet Trackpad."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזק את המקשים האלה וגלול מעל המסך בגלגלת העכבר כדי להחליק לאזורים שמעבר לקצוותיו. שתי אצבעות עושות זאת גם כאשר בלשונית משטח עקיבה נבחר ”מקשים ושתי אצבעות“."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन कुंजियों को दबाए रखें और माउस व्हील से स्क्रीन के ऊपर स्क्रोल करके उसके किनारों के पार वाले ज़ोन तक फिसलें। ट्रैकपैड टैब में “कुंजियाँ और दो उँगलियाँ” चुना हो तो दो उँगलियाँ भी यही करती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite ove tipke i pomičite kotačićem miša iznad zaslona za klizanje do zona izvan njegovih rubova. S dva prsta to također radi kada je na kartici Trackpad odabrano „Tipke i dva prsta“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa lenyomva ezeket a billentyűket, és görgessen az egérkerékkel a képernyő fölött, hogy a szélein túli zónákra csússzon. Két ujjal is működik, ha a Trackpad lapon a „Billentyűk és két ujj” van kiválasztva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol ini dan gulir di atas layar dengan roda mouse untuk meluncur ke zona di luar tepinya. Dua jari juga bisa saat “Tombol dan dua jari” dipilih di tab Trackpad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuti questi tasti e scorri sopra lo schermo con la rotellina del mouse per passare alle zone oltre i suoi bordi. Funziona anche con due dita quando nella scheda Trackpad è scelto «Tasti e due dita»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのキーを押したまま、画面の上でマウスホイールをスクロールすると、画面の端の外にあるゾーンへスライドします。「トラックパッド」タブで「キーと2本指」を選んでいる場合は、2本指でも同様に操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키를 누른 채 화면 위에서 마우스 휠로 스크롤하면 가장자리 너머의 영역으로 미끄러지듯 이동합니다. 트랙패드 탭에서 “키와 두 손가락”를 선택하면 두 손가락으로도 할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laikykite nuspaudę šiuos klavišus ir pelės ratuku slinkite virš ekrano, kad slystumėte į zonas už jo kraštų. Dviem pirštais tai veikia, kai skirtuke „Jutiklinė planšetė“ pasirinkta „Klavišai ir du pirštai“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turiet nospiestus šos taustiņus un ritiniet virs ekrāna ar peles ritenīti, lai slīdētu uz zonām aiz tā malām. Ar diviem pirkstiem tas darbojas arī tad, ja cilnē Skārienpaliktnis izvēlēts „Taustiņi un divi pirksti”."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या कळा दाबून ठेवा आणि माउस व्हीलने स्क्रीनवर स्क्रोल करून तिच्या कडांच्या पलीकडील झोनकडे सरका. ट्रॅकपॅड टॅबमध्ये “कळा आणि दोन बोटे” निवडले असल्यास दोन बोटेही हेच करतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan kekunci ini dan tatal di atas skrin dengan roda tetikus untuk meluncur ke zon di luar tepinya. Dua jari juga boleh apabila “Kekunci dan dua jari” dipilih dalam tab Pad jejak."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold disse tastene nede og rull over skjermen med musehjulet for å gli til sonene utenfor kantene. To fingre fungerer også når «Taster og to fingre» er valgt i fanen Styreflate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd deze toetsen ingedrukt en scrol met het muiswiel over het scherm om naar de zones voorbij de randen te glijden. Twee vingers werken ook als op het tabblad Trackpad ‘Toetsen en twee vingers’ is gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj te klawisze i przewijaj kółkiem myszy nad ekranem, aby przesuwać się do stref poza jego krawędziami. Dwa palce też działają, gdy na karcie Gładzik wybrano „Klawisze i dwa palce”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premidas estas teclas e desloque sobre o ecrã com a roda do rato para ir para as zonas além das suas margens. Com dois dedos também funciona quando está escolhido «Teclas e dois dedos» no separador Trackpad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionadas estas teclas e role sobre a tela com a roda do mouse para ir às zonas além das bordas dela. Com dois dedos também funciona quando “Teclas e dois dedos” está escolhido na aba Trackpad."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsate aceste taste și derulează deasupra ecranului cu rotița mouse-ului pentru a aluneca spre zonele din afara marginilor lui. Merge și cu două degete când în fila Trackpad este aleasă opțiunea „Taste și două degete”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте эти клавиши и прокручивайте колесиком мыши над экраном, чтобы скользить к зонам за его краями. Двумя пальцами это тоже работает, если на вкладке «Трекпад» выбрано «Клавиши и два пальца»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte tieto klávesy a kolieskom myši posúvajte nad obrazovkou, aby ste sa presunuli do zón za jej okrajmi. Dvoma prstami to funguje aj vtedy, keď je na karte Trackpad zvolené „Klávesy a dva prsty“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite te tipke in z miškinim kolescem drsite nad zaslonom, da zdrsnete na cone zunaj njegovih robov. Z dvema prstoma deluje tudi, ko je na zavihku Sledilna ploščica izbrano »Tipke in dva prsta«."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Држите ове тастере и померајте точкићем миша изнад екрана да бисте клизили до зона изван његових ивица. Са два прста то такође ради када је на картици Трекпед изабрано „Тастери и два прста“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned de här tangenterna och rulla med mushjulet över skärmen för att glida till zonerna bortom dess kanter. Två fingrar fungerar också när ”Tangenter och två fingrar” är valt på fliken Styrplatta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த விசைகளை அழுத்திப் பிடித்து, மவுஸ் சக்கரத்தால் திரையின் மேல் உருட்டினால் அதன் விளிம்புகளுக்கு அப்பால் உள்ள மண்டலங்களுக்கு நகரலாம். டிராக்பேட் தாவலில் “விசைகள் மற்றும் இரண்டு விரல்கள்” தேர்ந்தெடுக்கப்பட்டிருந்தால் இரண்டு விரல்களும் இதையே செய்யும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ కీలను నొక్కి పట్టుకుని, మౌస్ వీల్‌తో స్క్రీన్ పైన స్క్రోల్ చేస్తే దాని అంచులకు అవతల ఉన్న జోన్‌లకు జారవచ్చు. ట్రాక్‌ప్యాడ్ ట్యాబ్‌లో “కీలు మరియు రెండు వేళ్లు” ఎంచుకుంటే రెండు వేళ్లు కూడా ఇదే చేస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดปุ่มเหล่านี้ค้างไว้แล้วเลื่อนลูกกลิ้งเมาส์เหนือหน้าจอเพื่อเลื่อนไปยังโซนที่อยู่นอกขอบจอ สองนิ้วก็ใช้ได้เช่นกันเมื่อเลือก “ปุ่มและสองนิ้ว” ในแท็บแทร็กแพด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tuşları basılı tutup fare tekerleğiyle ekranın üzerinde kaydırarak kenarlarının ötesindeki bölgelere geçin. İzleme dörtgeni sekmesinde “Tuşlar ve iki parmak” seçiliyse iki parmak da aynısını yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте ці клавіші та прокручуйте коліщатком миші над екраном, щоб ковзати до зон за його краями. Двома пальцями це теж працює, якщо на вкладці «Трекпад» вибрано «Клавіші та два пальці»."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کیز کو دبائے رکھیں اور ماؤس وہیل سے اسکرین کے اوپر اسکرول کر کے اس کے کناروں سے پرے زونز تک پھسلیں۔ ٹریک پیڈ ٹیب میں “کیز اور دو انگلیاں” منتخب ہو تو دو انگلیاں بھی یہی کرتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ các phím này và cuộn bằng con lăn chuột phía trên màn hình để trượt tới các vùng nằm ngoài các cạnh của nó. Hai ngón tay cũng làm được khi chọn “Phím và hai ngón tay” trong tab Bàn di chuột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住这些按键，用鼠标滚轮在屏幕上方滚动，即可滑到屏幕边缘之外的区域。在“触控板”标签页中选择“按键和两指”时，两指也可以这样操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住這些按鍵，用滑鼠滾輪在螢幕上方捲動，即可滑到螢幕邊緣之外的區域。在「觸控式軌跡板」標籤頁中選擇「按鍵和兩指」時，兩指也可以這樣操作。"
          }
        }
      }
    },
