        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el puntero un segundo en el borde izquierdo o derecho de la pantalla para ver las zonas más allá de ese borde. No necesita trackpad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia kursorit sekund ekraani vasakul või paremal serval, et selle serva taga olevad tsoonid nähtavale tuua. Puuteplaati pole vaja."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانگر را یک ثانیه در لبهٔ چپ یا راست صفحه نگه دارید تا ناحیه‌های فراتر از آن لبه نمایان شوند. به ترک‌پد نیازی نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä osoitinta sekunti näytön vasemmassa tai oikeassa reunassa tuodaksesi reunan ulkopuoliset alueet näkyviin. Ohjauslevyä ei tarvita."
