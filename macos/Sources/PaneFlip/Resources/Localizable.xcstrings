          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a PaneFlip ver las ventanas de otras apps y moverlas a zonas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võimaldab PaneFlipil näha teiste rakenduste aknaid ja liigutada neid tsoonidesse."
