        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به PaneFlip اجازه می‌دهد پنجره‌های برنامه‌های دیگر را ببیند و آن‌ها را به ناحیه‌ها منتقل کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa PaneFlipin nähdä muiden sovellusten ikkunat ja siirtää ne alueisiin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapayagan ang PaneFlip na makita ang mga window ng ibang app at ilipat ang mga ito sa mga zone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
