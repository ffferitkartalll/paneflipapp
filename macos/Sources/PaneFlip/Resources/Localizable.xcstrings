        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काही डिस्प्ले त्यांच्या डावीकडील डिस्प्लेपेक्षा खाली आहेत. जिना उजवीकडे वर गेला पाहिजे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesetengah paparan lebih rendah daripada paparan di sebelah kirinya. Tangga mesti naik ke kanan."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen skjermer ligger lavere enn skjermen til venstre for dem. Trappen må gå oppover mot høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige schermen liggen lager dan het scherm links ervan. De trap moet naar rechts omhoog gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre wyświetlacze leżą niżej niż wyświetlacz po ich lewej. Schody muszą wznosić się w prawo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns ecrãs estão mais abaixo do que o ecrã à sua esquerda. A escada tem de subir para a direita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas telas estão mais abaixo do que a tela à sua esquerda. A escada precisa subir para a direita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unele ecrane sunt mai jos decât ecranul din stânga lor. Scara trebuie să urce spre dreapta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые дисплеи расположены ниже дисплея слева. Лестница должна подниматься вправо."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré displeje ležia nižšie ako displej vľavo od nich. Schody musia stúpať doprava."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
