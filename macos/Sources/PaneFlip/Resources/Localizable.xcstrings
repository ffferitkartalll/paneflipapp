        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaikykite žymeklį sekundę kairiajame ar dešiniajame ekrano krašte, kad būtų parodytos zonos už to krašto. Liečiamojo kilimėlio nereikia."
