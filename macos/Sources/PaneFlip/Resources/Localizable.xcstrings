    "Hides the pill under the pointer until the pointer moves away. Works with one modifier key: Shift, Control, Option or Command." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي الكبسولة الموجودة أسفل المؤشر إلى أن يتحرك المؤشر بعيدًا. يعمل مع مفتاح تعديل واحد: Shift أو Control أو Option أو Command."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрива хапчето под курсора, докато курсорът не се отдалечи. Работи с един модифициращ клавиш: Shift, Control, Option или Command."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পয়েন্টার সরে না যাওয়া পর্যন্ত পয়েন্টারের নিচের পিল লুকিয়ে রাখে। একটি মডিফায়ার কী-র সাথে কাজ করে: Shift, Control, Option বা Command।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga la píndola sota el punter fins que el punter s’allunya. Funciona amb una tecla modificadora: Majúscules, Control, Opció o Comandament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje pilulku pod ukazatelem, dokud se ukazatel neodsune. Funguje s jednou modifikační klávesou: Shift, Control, Option nebo Command."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler pillen under markøren, indtil markøren flyttes væk. Fungerer med én ændringstast: Shift, Control, Option eller Command."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die Pille unter dem Zeiger aus, bis der Zeiger sich entfernt. Funktioniert mit einer Sondertaste: Shift, Control, Option oder Command."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρύβει το χάπι κάτω από τον δείκτη μέχρι ο δείκτης να απομακρυνθεί. Λειτουργεί με ένα πλήκτρο τροποποίησης: Shift, Control, Option ή Command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta la píldora bajo el puntero hasta que este se aleje. Funciona con una tecla modificadora: Mayús, Control, Opción o Comando."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peidab kursori all oleva tableti, kuni kursor eemale liigub. Töötab ühe muuteklahviga: Shift, Control, Option või Command."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرص زیر نشانگر را تا زمانی که نشانگر دور شود پنهان می‌کند. با یک کلید تغییردهنده کار می‌کند: Shift، Control، Option یا Command."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa osoittimen alla olevan pillerin, kunnes osoitin siirtyy pois. Toimii yhdellä muuntonäppäimellä: Vaihto, Control, Optio tai Komento."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinatago ang pill sa ilalim ng pointer hanggang lumayo ang pointer. Gumagana sa isang modifier key: Shift, Control, Option o Command."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque la pastille sous le pointeur jusqu’à ce que celui-ci s’éloigne. Fonctionne avec une touche de modification : Maj, Contrôle, Option ou Commande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את הגלולה שמתחת למצביע עד שהמצביע מתרחק. פועל עם מקש משנה אחד: Shift, Control, Option או Command."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पॉइंटर के नीचे मौजूद पिल को तब तक छिपाता है जब तक पॉइंटर दूर नहीं हो जाता। एक मॉडिफ़ायर कुंजी के साथ काम करता है: Shift, Control, Option या Command।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriva tabletu ispod pokazivača dok se pokazivač ne makne. Radi s jednom modifikatorskom tipkom: Shift, Control, Option ili Command."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elrejti a mutató alatti pirulát, amíg a mutató el nem mozdul. Egy módosítóbillentyűvel működik: Shift, Control, Option vagy Command."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan pil di bawah penunjuk hingga penunjuk menjauh. Berfungsi dengan satu tombol pengubah: Shift, Control, Option, atau Command."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde la pillola sotto il puntatore finché il puntatore non si sposta. Funziona con un tasto modificatore: Maiusc, Controllo, Opzione o Comando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタの下にあるピルを、ポインタが離れるまで隠します。修飾キーを1つ使用できます：Shift、Control、Option、Command。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 벗어날 때까지 포인터 아래의 알약을 숨깁니다. 보조 키 하나와 함께 작동합니다: Shift, Control, Option 또는 Command."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslepia tabletę po žymekliu, kol žymeklis nenueina šalin. Veikia su vienu modifikavimo klavišu: Shift, Control, Option arba Command."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paslēpj tableti zem kursora, līdz kursors tiek pārvietots prom. Darbojas ar vienu modifikatora taustiņu: Shift, Control, Option vai Command."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पॉइंटर दूर जाईपर्यंत पॉइंटरखालील गोळी लपवते. एका मॉडिफायर कीसह कार्य करते: Shift, Control, Option किंवा Command."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan pil di bawah penuding sehingga penuding bergerak menjauh. Berfungsi dengan satu kekunci pengubah suai: Shift, Control, Option atau Command."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler pillen under pekeren til pekeren flyttes bort. Fungerer med én modifikatortast: Skift, Control, Alternativ eller Kommando."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt de pil onder de aanwijzer totdat de aanwijzer wegbeweegt. Werkt met één wijzigingstoets: Shift, Control, Option of Command."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa pigułkę pod wskaźnikiem, dopóki wskaźnik się nie oddali. Działa z jednym klawiszem modyfikującym: Shift, Control, Option lub Command."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta a pílula sob o ponteiro até que o ponteiro se afaste. Funciona com uma tecla modificadora: Shift, Control, Option ou Command."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta a pílula sob o ponteiro até que o ponteiro se afaste. Funciona com uma tecla modificadora: Shift, Control, Option ou Command."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde pastila de sub cursor până când cursorul se îndepărtează. Funcționează cu o tastă modificatoare: Shift, Control, Option sau Command."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает таблетку под указателем, пока указатель не отодвинется. Работает с одной клавишей-модификатором: Shift, Control, Option или Command."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryje pilulku pod ukazovateľom, kým sa ukazovateľ neodsunie. Funguje s jednou modifikačnou klávesou: Shift, Control, Option alebo Command."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrije tableto pod kazalcem, dokler se kazalec ne umakne. Deluje z eno tipko za spreminjanje: Shift, Control, Option ali Command."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сакрива таблету испод показивача док се показивач не помери. Ради са једном модификаторском типком: Shift, Control, Option или Command."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer pillret under pekaren tills pekaren flyttas bort. Fungerar med en modifierarknapp: Skift, Control, Alternativ eller Kommando."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சுட்டி விலகும் வரை சுட்டியின் கீழுள்ள மாத்திரையை மறைக்கிறது. ஒரு மாற்றி விசையுடன் செயல்படும்: Shift, Control, Option அல்லது Command."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పాయింటర్ దూరంగా వెళ్లే వరకు పాయింటర్ కింద ఉన్న మాత్రను దాస్తుంది. ఒక మాడిఫైయర్ కీతో పనిచేస్తుంది: Shift, Control, Option లేదా Command."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนแคปซูลใต้ตัวชี้จนกว่าตัวชี้จะเลื่อนออกไป ใช้ได้กับปุ่มตัวปรับแต่งหนึ่งปุ่ม: Shift, Control, Option หรือ Command"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç uzaklaştırılana kadar imlecin altındaki hapı gizler. Sadece bir niteleme tuşu ile çalışır: Shift, Control, Option ve Command."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховує таблетку під вказівником, доки вказівник не відсунеться. Працює з однією клавішею-модифікатором: Shift, Control, Option або Command."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوائنٹر کے ہٹنے تک پوائنٹر کے نیچے موجود گولی کو چھپاتا ہے۔ ایک موڈیفائر کلید کے ساتھ کام کرتا ہے: Shift، Control، Option یا Command۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn viên thuốc dưới con trỏ cho đến khi con trỏ di chuyển đi. Hoạt động với một phím bổ trợ: Shift, Control, Option hoặc Command."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指针移开之前，隐藏指针下方的胶囊。可配合一个修饰键使用：Shift、Control、Option 或 Command。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指標移開之前，隱藏指標下方的膠囊。可搭配一個修飾鍵使用：Shift、Control、Option 或 Command。"
          }
        }
      }
    },
