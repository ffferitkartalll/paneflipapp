    "PaneFlip leaves the windows of these apps alone: they are never placed in a zone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يترك PaneFlip نوافذ هذه التطبيقات وشأنها: لا توضع أبدًا في منطقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip не пипа прозорците на тези приложения: те никога не се поставят в зона."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip এই অ্যাপগুলোর উইন্ডো স্পর্শ করে না: সেগুলো কখনও কোনো জোনে বসানো হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip no toca les finestres d'aquestes aplicacions: mai es posen en una zona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip nechává okna těchto aplikací na pokoji: nikdy je neumístí do zóny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip lader vinduerne fra disse apps være: de placeres aldrig i en zone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip lässt die Fenster dieser Apps in Ruhe: Sie werden nie in eine Zone gesetzt."
