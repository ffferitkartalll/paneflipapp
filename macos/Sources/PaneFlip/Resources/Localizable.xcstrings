        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip پنجره‌های این برنامه‌ها را رها می‌کند: هرگز در ناحیه‌ای قرار نمی‌گیرند."
          }
        },
        "fi" : {
