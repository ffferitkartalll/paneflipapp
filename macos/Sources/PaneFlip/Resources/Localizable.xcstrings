    "Zones beyond the screen's edge are reached by scrolling.\nDouble-click the handle on the dashed line to remove them" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُوصَل إلى المناطق خارج حافة الشاشة بالتمرير.\nانقر مرتين على المقبض على الخط المتقطع لإزالتها"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До зоните извън края на екрана се стига с превъртане.\nНатиснете двукратно манипулатора на пунктираната линия, за да ги премахнете"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিনের প্রান্তের বাইরের জোনে স্ক্রল করে পৌঁছানো যায়।\nসরাতে ড্যাশ লাইনের হ্যান্ডেলে ডাবল-ক্লিক করুন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es arriba a les zones més enllà de la vora de la pantalla desplaçant.\nFes doble clic a l'ansa de la línia discontínua per treure-les"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K zónám za okrajem obrazovky se dostanete posouváním.\nDvojitým kliknutím na úchyt na čárkované čáře je odstraníte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoner uden for skærmkanten nås ved at rulle.\nDobbeltklik på håndtaget på den stiplede linje for at fjerne dem"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonen jenseits des Bildschirmrands erreichst du durch Scrollen.\nDoppelklicke auf den Griff an der gestrichelten Linie, um sie zu entfernen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις ζώνες πέρα από την άκρη της οθόνης φτάνετε με κύλιση.\nΚάντε διπλό κλικ στη λαβή της διακεκομμένης γραμμής για να τις αφαιρέσετε"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las zonas más allá del borde de la pantalla se llega desplazando.\nHaz doble clic en el tirador de la línea discontinua para quitarlas"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekraani servast väljaspool olevate tsoonideni jõuab kerides.\nEemaldamiseks topeltklõpsa katkendjoone käepidemel"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به ناحیه‌های خارج از لبهٔ صفحه با پیمایش می‌رسید.\nبرای حذف آن‌ها روی دستگیرهٔ خط‌چین دوبار کلیک کنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytön reunan ulkopuolisiin alueisiin pääsee vierittämällä.\nPoista ne kaksoisnapsauttamalla katkoviivan kahvaa"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naaabot ang mga zone sa labas ng gilid ng screen sa pamamagitan ng pag-scroll.\nI-double-click ang handle sa putol-putol na linya para alisin ang mga ito"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On accède aux zones au-delà du bord de l'écran en faisant défiler.\nDouble-cliquez sur la poignée de la ligne en pointillés pour les supprimer"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגיעים לאזורים שמחוץ לקצה המסך על ידי גלילה.\nלחיצה כפולה על הידית שבקו המקווקו מסירה אותם"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन के किनारे के बाहर के ज़ोन तक स्क्रोल करके पहुँचा जाता है।\nउन्हें हटाने के लिए बिंदीदार रेखा के हैंडल पर डबल-क्लिक करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonama izvan ruba zaslona pristupa se pomicanjem.\nDvaput kliknite ručku na isprekidanoj liniji da ih uklonite"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyő szélén túli zónák görgetéssel érhetők el.\nEltávolításukhoz kattintson duplán a szaggatott vonal fogantyújára"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona di luar tepi layar dijangkau dengan menggulir.\nKlik dua kali gagang pada garis putus-putus untuk menghapusnya"
