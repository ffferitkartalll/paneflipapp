          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các phím tắt ở thẻ Phím tắt chuyển tiêu điểm sang vùng phía trên, bên trái, phía dưới hoặc bên phải."
