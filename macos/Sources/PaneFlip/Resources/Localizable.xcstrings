        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwanan ang pointer nang isang segundo sa kaliwa o kanang gilid ng screen para ipakita ang mga zone sa labas ng gilid na iyon. Hindi kailangan ng trackpad."
