        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר ל-PaneFlip לראות את החלונות של אפליקציות אחרות ולהעביר אותם לאזורים."
          }
        },
        "hi" : {
          "stringUnit" : {
