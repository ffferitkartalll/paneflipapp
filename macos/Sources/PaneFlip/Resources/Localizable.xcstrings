        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ डिस्प्ले अपने बाईं ओर वाले डिस्प्ले से नीचे हैं। सीढ़ी दाईं ओर ऊपर जानी चाहिए।"
