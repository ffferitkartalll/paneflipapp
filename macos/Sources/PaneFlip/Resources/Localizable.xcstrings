        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিনের প্রান্তের বাইরের জোনেও"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I també a zones fora de les vores de la pantalla"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I do zón za okraji obrazovky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Også til zoner uden for skærmens kanter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch zu Zonen jenseits der Bildschirmränder"
