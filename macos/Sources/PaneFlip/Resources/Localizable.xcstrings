    "Grant the access below in System Settings. This window updates as soon as you do." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح الوصول أدناه في إعدادات النظام. تتحدّث هذه النافذة فور قيامك بذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставете достъпа по-долу в Системни настройки. Този прозорец се обновява веднага щом го направите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিস্টেম সেটিংসে নিচের অ্যাক্সেস দিন। আপনি তা করলেই এই উইন্ডো আপডেট হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedeix l’accés següent a Configuració del Sistema. Aquesta finestra s’actualitza tan bon punt ho facis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělte níže uvedený přístup v Nastavení systému. Toto okno se aktualizuje, jakmile to uděláte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgangen nedenfor i Systemindstillinger. Dette vindue opdateres, så snart du gør det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erteile den unten genannten Zugriff in den Systemeinstellungen. Dieses Fenster aktualisiert sich, sobald du das getan hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραχωρήστε την παρακάτω πρόσβαση στις Ρυθμίσεις συστήματος. Αυτό το παράθυρο ενημερώνεται μόλις το κάνετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede el acceso indicado abajo en Ajustes del Sistema. Esta ventana se actualiza en cuanto lo hagas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andke allolev juurdepääs süsteemiseadetes. See aken uueneb kohe, kui seda teete."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی زیر را در تنظیمات سیستم بدهید. به محض انجام این کار، این پنجره به‌روزرسانی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myönnä alla oleva käyttöoikeus Järjestelmäasetuksissa. Tämä ikkuna päivittyy heti, kun teet sen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibigay ang access sa ibaba sa System Settings. Mag-a-update ang window na ito sa sandaling gawin mo ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez l’accès ci-dessous dans Réglages Système. Cette fenêtre se met à jour dès que vous le faites."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הענק את הגישה שלהלן בהגדרות המערכת. חלון זה יתעדכן ברגע שתעשה זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ में नीचे दिया गया एक्सेस दें। आपके ऐसा करते ही यह विंडो अपडेट हो जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite pristup u nastavku u Postavkama sustava. Ovaj prozor ažurira se čim to učinite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg az alábbi hozzáférést a Rendszerbeállításokban. Ez az ablak azonnal frissül, amint megteszi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan akses di bawah ini di Pengaturan Sistem. Jendela ini akan diperbarui segera setelah Anda melakukannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi l’accesso indicato di seguito in Impostazioni di Sistema. Questa finestra si aggiorna non appena lo fai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で以下のアクセスを許可してください。許可するとこのウインドウはすぐに更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 아래 접근 권한을 허용하세요. 허용하면 이 창이 바로 업데이트됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suteikite toliau nurodytą prieigą Sistemos nustatymuose. Šis langas atsinaujins, kai tik tai padarysite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piešķiriet tālāk norādīto piekļuvi sistēmas iestatījumos. Šis logs atjaunosies, tiklīdz to izdarīsiet."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्जमध्ये खालील अ‍ॅक्सेस द्या. तुम्ही तसे करताच ही विंडो अपडेट होईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan akses di bawah dalam Tetapan Sistem. Tetingkap ini dikemas kini sebaik sahaja anda berbuat demikian."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi tilgangen nedenfor i Systeminnstillinger. Dette vinduet oppdateres så snart du gjør det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen de onderstaande toegang in Systeminstellingen. Dit venster wordt bijgewerkt zodra je dat doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj poniższy dostęp w Ustawieniach systemowych. To okno zaktualizuje się, gdy tylko to zrobisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda o acesso abaixo em Definições do Sistema. Esta janela é atualizada assim que o fizer."
