    "Rest the pointer at the left or right edge of the screen for a second to bring the zones beyond that edge into view. Needs no trackpad." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ المؤشر ثانية واحدة عند الحافة اليسرى أو اليمنى للشاشة لإظهار المناطق خلف تلك الحافة. لا حاجة إلى لوحة تتبع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте показалеца за секунда на левия или десния край на екрана, за да се покажат зоните зад този край. Не е нужен тракпад."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেই প্রান্তের বাইরের জোন দেখাতে পয়েন্টার স্ক্রিনের বাঁ বা ডান প্রান্তে এক সেকেন্ড রাখুন। ট্র্যাকপ্যাড লাগে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa el punter un segon a la vora esquerra o dreta de la pantalla per veure les zones més enllà d'aquesta vora. No cal trackpad."
