    "PaneFlip downloads the new version, replaces itself with it and starts again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل PaneFlip الإصدار الجديد ويستبدل نفسه به ثم يبدأ من جديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip изтегля новата версия, замества се с нея и се стартира отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip নতুন সংস্করণ ডাউনলোড করে, নিজেকে সেটি দিয়ে বদলে ফেলে এবং আবার চালু হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip baixa la nova versió, se substitueix per ella i es torna a obrir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip stáhne novou verzi, nahradí se jí a spustí se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip henter den nye version, erstatter sig selv med den og starter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip lädt die neue Version herunter, ersetzt sich damit und startet neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το PaneFlip κατεβάζει τη νέα έκδοση, αντικαθιστά τον εαυτό του με αυτήν και ξεκινά ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip descarga la nueva versión, se sustituye por ella y se vuelve a abrir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip laadib uue versiooni alla, asendab end sellega ja käivitub uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip نسخهٔ جدید را دانلود می‌کند، خودش را با آن جایگزین می‌کند و دوباره اجرا می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip lataa uuden version, korvaa itsensä sillä ja käynnistyy uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina-download ng PaneFlip ang bagong bersyon, pinapalitan ang sarili nito, at magbubukas muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip télécharge la nouvelle version, se remplace par elle et redémarre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip מוריד את הגרסה החדשה, מחליף את עצמו בה ומופעל מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip नया संस्करण डाउनलोड करता है, खुद को उससे बदल लेता है और फिर से खुलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip preuzima novu verziju, zamjenjuje se njome i ponovno se pokreće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A PaneFlip letölti az új verziót, lecseréli magát, és újraindul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip mengunduh versi baru, menggantikan dirinya dengan versi itu, lalu dibuka kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip scarica la nuova versione, si sostituisce con essa e si riavvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip が新しいバージョンをダウンロードして自身を置き換え、再び起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip이 새 버전을 내려받아 스스로를 교체하고 다시 시작합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„PaneFlip“ atsisiunčia naują versiją, pakeičia save ja ir paleidžiama iš naujo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
