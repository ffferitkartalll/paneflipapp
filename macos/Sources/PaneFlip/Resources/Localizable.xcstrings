    "You changed the app language, so you need to restart PaneFlip for the change to take effect." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد غيّرت لغة التطبيق، لذا عليك إعادة تشغيل PaneFlip لكي يسري التغيير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Променихте езика на приложението, затова трябва да рестартирате PaneFlip, за да влезе в сила промяната."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অ্যাপের ভাষা পরিবর্তন করেছেন, তাই পরিবর্তন কার্যকর হতে PaneFlip রিস্টার্ট করতে হবে।"
