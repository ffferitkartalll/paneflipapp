        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το PaneFlip αφήνει ήσυχα τα παράθυρα αυτών των εφαρμογών: δεν τοποθετούνται ποτέ σε ζώνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip no toca las ventanas de estas apps: nunca se colocan en una zona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip jätab nende rakenduste aknad rahule: neid ei paigutata kunagi tsooni."
