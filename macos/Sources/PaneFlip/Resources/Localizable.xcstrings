    "Also to zones beyond the screen's edges" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وإلى المناطق خارج حواف الشاشة أيضًا"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "И към зони извън краищата на екрана"
