    "Zones light up while the keys are held during the drag; release the mouse over a zone to add the window." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضيء المناطق أثناء الضغط على المفاتيح خلال السحب؛ حرّر الفأرة فوق منطقة لإضافة النافذة إليها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зоните светват, докато клавишите са натиснати по време на плъзгането; пуснете мишката върху зона, за да добавите прозореца."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টেনে আনার সময় কিগুলো চেপে ধরে রাখলে জোনগুলো জ্বলে ওঠে; উইন্ডো যোগ করতে কোনো জোনের ওপর মাউস ছেড়ে দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones s'il·luminen mentre es mantenen premudes les tecles durant l'arrossegament; deixa anar el ratolí sobre una zona per afegir-hi la finestra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóny se rozsvítí, dokud při přetahování držíte klávesy; pusťte myš nad zónou a okno do ní přidáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonerne lyser, mens tasterne holdes nede under trækket; slip musen over en zone for at tilføje vinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zonen leuchten auf, solange die Tasten beim Ziehen gedrückt sind; lass die Maus über einer Zone los, um das Fenster hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ζώνες φωτίζονται όσο κρατάτε πατημένα τα πλήκτρα κατά τη μεταφορά· αφήστε το ποντίκι πάνω από μια ζώνη για να προσθέσετε το παράθυρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las zonas se iluminan mientras se mantienen pulsadas las teclas durante el arrastre; suelta el ratón sobre una zona para añadir la ventana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tsoonid süttivad, kuni klahve lohistamise ajal all hoitakse; akna lisamiseks lase hiir tsooni kohal lahti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تا زمانی که کلیدها را هنگام کشیدن نگه دارید، ناحیه‌ها روشن می‌شوند؛ برای افزودن پنجره، ماوس را روی یک ناحیه رها کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alueet syttyvät, kun näppäimiä pidetään painettuna vedon aikana; lisää ikkuna vapauttamalla hiiri alueen päällä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umiilaw ang mga zone habang hawak ang mga key sa pag-drag; bitawan ang mouse sa ibabaw ng isang zone para idagdag ang window."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones s'allument tant que les touches sont maintenues pendant le glissement ; relâchez la souris sur une zone pour y ajouter la fenêtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האזורים נדלקים כל עוד המקשים לחוצים בזמן הגרירה; שחרר את העכבר מעל אזור כדי להוסיף אליו את החלון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खींचते समय कुंजियाँ दबाए रखने तक ज़ोन चमकते हैं; विंडो जोड़ने के लिए माउस को किसी ज़ोन के ऊपर छोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone svijetle dok se tipke drže tijekom povlačenja; otpustite miš iznad zone da u nju dodate prozor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zónák kivilágosodnak, amíg a húzás közben nyomva tartod a billentyűket; engedd el az egeret egy zóna fölött, hogy hozzáadd az ablakot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona menyala selama tombol ditahan saat menyeret; lepaskan mouse di atas zona untuk menambahkan jendela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le zone si illuminano finché i tasti restano premuti durante il trascinamento; rilascia il mouse su una zona per aggiungervi la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグ中にキーを押している間、ゾーンが点灯します。ゾーンの上でマウスを離すと、ウインドウがそこに追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하는 동안 키를 누르고 있으면 영역이 켜집니다. 영역 위에서 마우스를 놓으면 윈도우가 추가됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonos šviečia, kol vilkdami laikote nuspaustus klavišus; atleiskite pelę virš zonos, kad pridėtumėte langą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonas iedegas, kamēr velkot turat nospiestus taustiņus; atlaidiet peli virs zonas, lai tai pievienotu logu."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ड्रॅग करताना कळा दाबून ठेवेपर्यंत झोन उजळतात; विंडो जोडण्यासाठी माउस झोनवर सोडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zon menyala selagi kekunci ditahan semasa menyeret; lepaskan tetikus di atas zon untuk menambah tetingkap."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonene lyser mens tastene holdes inne under draing; slipp musen over en sone for å legge til vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De zones lichten op zolang je tijdens het slepen de toetsen ingedrukt houdt; laat de muis los boven een zone om het venster toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strefy zaświecają się, dopóki podczas przeciągania trzymasz klawisze; puść mysz nad strefą, aby dodać do niej okno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As zonas acendem-se enquanto as teclas são mantidas premidas durante o arrasto; solte o rato sobre uma zona para adicionar a janela."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As zonas acendem enquanto as teclas são mantidas pressionadas durante o arrasto; solte o mouse sobre uma zona para adicionar a janela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonele se aprind cât timp ții apăsate tastele în timpul tragerii; eliberează mouse-ul peste o zonă ca să adaugi fereastra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зоны подсвечиваются, пока при перетаскивании удерживаются клавиши; отпустите мышь над зоной, чтобы добавить в неё окно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóny sa rozsvietia, kým pri presúvaní držíte klávesy; pustite myš nad zónou a okno do nej pridáte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Območja zasvetijo, dokler med vlečenjem držite tipke; spustite miško nad območjem, da vanj dodate okno."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зоне светле док се током превлачења држе тастери; отпустите миш изнад зоне да бисте јој додали прозор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonerna lyser upp medan tangenterna hålls nere under dragningen; släpp musen över en zon för att lägga till fönstret."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இழுக்கும்போது விசைகளை அழுத்திப் பிடித்திருக்கும் வரை மண்டலங்கள் ஒளிரும்; சாளரத்தைச் சேர்க்க மண்டலத்தின் மேல் சுட்டியை விடுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లాగుతున్నప్పుడు కీలను నొక్కి ఉంచినంత సేపు జోన్‌లు వెలుగుతాయి; విండోను జోడించడానికి జోన్ పైన మౌస్‌ను వదలండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โซนจะสว่างขึ้นขณะที่กดปุ่มค้างไว้ระหว่างการลาก ปล่อยเมาส์เหนือโซนเพื่อเพิ่มหน้าต่างลงไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürüklerken tuşlar basılı tutulduğu sürece bölgeler yanar; pencereyi eklemek için fareyi bir bölgenin üzerinde bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зони підсвічуються, доки під час перетягування утримуються клавіші; відпустіть мишу над зоною, щоб додати до неї вікно."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گھسیٹتے وقت جب تک کیز دبی رہیں زونز روشن رہتے ہیں؛ ونڈو شامل کرنے کے لیے ماؤس کو کسی زون پر چھوڑ دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các vùng sáng lên khi bạn giữ các phím trong lúc kéo; thả chuột trên một vùng để thêm cửa sổ vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动时按住按键，区域就会亮起；在区域上松开鼠标即可把窗口添加进去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移時按住按鍵，區域就會亮起；在區域上放開滑鼠即可將視窗加入。"
          }
        }
      }
    }
