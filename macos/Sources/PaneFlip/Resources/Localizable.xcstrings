        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordă accesul de mai jos în Setări de sistem. Această fereastră se actualizează de îndată ce o faci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
