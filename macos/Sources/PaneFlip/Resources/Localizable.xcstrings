    "Lets PaneFlip take a picture of a window, so it can slide in beside another one inside its zone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لـ PaneFlip التقاط صورة لنافذة، ليتمكن من تمريرها بجانب نافذة أخرى داخل منطقتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на PaneFlip да прави снимка на прозорец, за да може той да се плъзне до друг прозорец в рамките на своята зона."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip-কে একটি উইন্ডোর ছবি তুলতে দেয়, যাতে সেটি তার জোনের ভেতরে অন্য একটি উইন্ডোর পাশে স্লাইড করে আসতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que PaneFlip faci una captura d’una finestra, perquè pugui lliscar al costat d’una altra dins de la seva zona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip pořídit snímek okna, aby se mohlo vsunout vedle jiného okna uvnitř své zóny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader PaneFlip tage et billede af et vindue, så det kan glide ind ved siden af et andet inden for sin zone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt PaneFlip, ein Bild eines Fensters aufzunehmen, damit es innerhalb seiner Zone neben ein anderes gleiten kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στο PaneFlip να τραβά μια εικόνα ενός παραθύρου, ώστε να γλιστρά δίπλα σε ένα άλλο μέσα στη ζώνη του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a PaneFlip hacer una captura de una ventana para que pueda deslizarse junto a otra dentro de su zona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võimaldab PaneFlipil teha aknast pildi, et see saaks oma tsoonis teise akna kõrvale libiseda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به PaneFlip اجازه می‌دهد از یک پنجره تصویر بگیرد تا بتواند در ناحیه‌ی خود کنار پنجره‌ای دیگر بلغزد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa PaneFlipin ottaa kuvan ikkunasta, jotta se voi liukua toisen ikkunan viereen omalla alueellaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapayagan ang PaneFlip na kumuha ng larawan ng isang window, para makapag-slide ito sa tabi ng isa pa sa loob ng zone nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à PaneFlip de prendre une image d’une fenêtre pour qu’elle puisse glisser à côté d’une autre dans sa zone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר ל-PaneFlip לצלם תמונה של חלון, כדי שיוכל לגלוש לצד חלון אחר בתוך האזור שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip को किसी विंडो की तस्वीर लेने देता है, ताकि वह अपने ज़ोन के भीतर किसी दूसरी विंडो के बगल में स्लाइड होकर आ सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje PaneFlipu da snimi sliku prozora kako bi mogao kliznuti pokraj drugog prozora unutar svoje zone."
