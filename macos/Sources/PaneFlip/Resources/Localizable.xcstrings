        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένες οθόνες βρίσκονται χαμηλότερα από την οθόνη στα αριστερά τους. Η σκάλα πρέπει να ανεβαίνει προς τα δεξιά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
