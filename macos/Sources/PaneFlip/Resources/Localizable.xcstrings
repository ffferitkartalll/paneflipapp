        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به PaneFlip اجازه می‌دهد از یک پنجره تصویر بگیرد تا بتواند در ناحیه‌ی خود کنار پنجره‌ای دیگر بلغزد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antaa PaneFlipin ottaa kuvan ikkunasta, jotta se voi liukua toisen ikkunan viereen omalla alueellaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapayagan ang PaneFlip na kumuha ng larawan ng isang window, para makapag-slide ito sa tabi ng isa pa sa loob ng zone nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à PaneFlip de prendre une image d’une fenêtre pour qu’elle puisse glisser à côté d’une autre dans sa zone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר ל-PaneFlip לצלם תמונה של חלון, כדי שיוכל לגלוש לצד חלון אחר בתוך האזור שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip को किसी विंडो की तस्वीर लेने देता है, ताकि वह अपने ज़ोन के भीतर किसी दूसरी विंडो के बगल में स्लाइड होकर आ सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje PaneFlipu da snimi sliku prozora kako bi mogao kliznuti pokraj drugog prozora unutar svoje zone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi, hogy a PaneFlip képet készítsen egy ablakról, így az a zónáján belül egy másik ablak mellé csúszhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengizinkan PaneFlip mengambil gambar jendela agar dapat bergeser ke samping jendela lain di dalam zonanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a PaneFlip di acquisire un’immagine di una finestra, così può scorrere accanto a un’altra all’interno della sua zona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlipがウインドウの画像を取得し、ゾーン内で別のウインドウの隣へスライドできるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip이 윈도우의 이미지를 가져와 영역 안에서 다른 윈도우 옆으로 밀려 들어올 수 있도록 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leidžia PaneFlip nufotografuoti langą, kad jis galėtų slysti šalia kito lango savo zonoje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļauj PaneFlip uzņemt loga attēlu, lai tas varētu ieslīdēt blakus citam logam savā zonā."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip ला विंडोचे चित्र घेऊ देते, जेणेकरून ती तिच्या झोनमध्ये दुसऱ्या विंडोच्या शेजारी सरकून येऊ शकेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membenarkan PaneFlip mengambil gambar tetingkap supaya ia boleh meluncur di sebelah tetingkap lain dalam zonnya."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar PaneFlip ta et bilde av et vindu, slik at det kan gli inn ved siden av et annet innenfor sin sone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat PaneFlip een beeld van een venster maken, zodat het binnen zijn zone naast een ander venster kan schuiven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala PaneFlip zrobić obraz okna, aby mogło wsunąć się obok innego okna w swojej strefie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o PaneFlip tire uma imagem de uma janela para que ela possa deslizar para junto de outra dentro da sua zona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o PaneFlip tire uma imagem de uma janela para que ela possa deslizar para o lado de outra dentro da sua zona."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite PaneFlip să facă o imagine a unei ferestre, astfel încât aceasta să poată aluneca lângă o altă fereastră în zona ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет PaneFlip делать снимок окна, чтобы оно могло плавно выехать рядом с другим окном внутри своей зоны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip urobiť snímku okna, aby sa mohlo vsunúť vedľa iného okna vo svojej zóne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoča PaneFlipu, da posname sliko okna, da lahko zdrsi ob drugo okno znotraj svojega območja."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућава PaneFlip-у да направи слику прозора како би могао да клизне поред другог прозора унутар своје зоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter PaneFlip ta en bild av ett fönster så att det kan glida in bredvid ett annat inom sin zon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip-ஐ ஒரு சாளரத்தின் படத்தை எடுக்க அனுமதிக்கிறது, அதனால் அது தனது மண்டலத்திற்குள் மற்றொரு சாளரத்தின் அருகே நகர்ந்து வர முடியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip‌ను ఒక విండో చిత్రాన్ని తీసుకోవడానికి అనుమతిస్తుంది, తద్వారా అది తన జోన్‌లో మరో విండో పక్కకు జారి రాగలదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ PaneFlip ถ่ายภาพหน้าต่าง เพื่อให้เลื่อนมาอยู่ข้างหน้าต่างอื่นภายในโซนของตัวเองได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip'in bir pencerenin görüntüsünü almasına izin verir; böylece pencere, bölgesi içinde başka bir pencerenin yanına kayarak gelebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє PaneFlip робити знімок вікна, щоб воно могло плавно виїхати поруч з іншим вікном у межах своєї зони."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip کو کسی ونڈو کی تصویر لینے دیتا ہے تاکہ وہ اپنے زون کے اندر دوسری ونڈو کے ساتھ سرک کر آ سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép PaneFlip chụp ảnh một cửa sổ để nó có thể trượt vào cạnh một cửa sổ khác trong vùng của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 PaneFlip 获取窗口的图像，以便该窗口在其区域内滑入另一个窗口旁边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 PaneFlip 取得視窗的影像，以便該視窗在其區域內滑入另一個視窗旁邊。"
          }
        }
      }
    },
    "Lets a layout have zones beyond the left and right edges of a screen. Reach them with the scroll shortcuts (see Shortcuts), or by scrolling over the island in the menu bar. Switched off, the editor does not show them and their apps move to the default zone of the screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح أن يحتوي التخطيط على مناطق خارج الحافتين اليمنى واليسرى للشاشة. يمكنك الوصول إليها باختصارات التمرير (راجع الاختصارات)، أو بالتمرير فوق الجزيرة في شريط القوائم. عند الإيقاف لا يعرضها المحرّر وتنتقل تطبيقاتها إلى المنطقة الافتراضية للشاشة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на оформлението да има зони извън левия и десния край на екрана. Стигате до тях с клавишните комбинации за превъртане (вижте Клавишни комбинации) или като превъртате над острова в лентата с менюта. Когато е изключено, редакторът не ги показва, а приложенията им преминават в зоната по подразбиране на екрана."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি লেআউটে স্ক্রিনের বাঁ ও ডান প্রান্তের বাইরে জোন রাখার সুযোগ দেয়। স্ক্রল শর্টকাট (শর্টকাট দেখুন) দিয়ে, অথবা মেনু বারের আইল্যান্ডের ওপর স্ক্রল করে সেগুলোতে পৌঁছানো যায়। বন্ধ থাকলে এডিটর সেগুলো দেখায় না এবং সেগুলোর অ্যাপ স্ক্রিনের ডিফল্ট জোনে চলে যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que una disposició tingui zones més enllà de les vores esquerra i dreta de la pantalla. S'hi arriba amb les dreceres de desplaçament (vegeu Dreceres) o desplaçant-se sobre l'illa de la barra de menús. Si està desactivat, l'editor no les mostra i les seves apps passen a la zona predeterminada de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní, aby rozložení mělo zóny za levým a pravým okrajem obrazovky. Dostanete se k nim zkratkami pro posouvání (viz Zkratky) nebo posouváním nad ostrovem v řádku nabídek. Když je vypnuto, editor je nezobrazuje a jejich aplikace přejdou do výchozí zóny obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader et layout have zoner uden for skærmens venstre og højre kant. Du når dem med rullegenvejene (se Genveje) eller ved at rulle over øen i menulinjen. Når det er slået fra, viser editoren dem ikke, og deres apps flyttes til skærmens standardzone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt einem Layout Zonen jenseits des linken und rechten Bildschirmrands. Du erreichst sie mit den Scroll-Tastenkürzeln (siehe Tastenkürzel) oder durch Scrollen über der Insel in der Menüleiste. Ist die Option aus, zeigt der Editor sie nicht an, und ihre Apps wandern in die Standardzone des Bildschirms."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει σε μια διάταξη να έχει ζώνες πέρα από το αριστερό και το δεξί άκρο της οθόνης. Τις φτάνετε με τις συντομεύσεις κύλισης (βλ. Συντομεύσεις) ή κυλώντας πάνω από το νησί στη γραμμή μενού. Όταν είναι απενεργοποιημένο, ο επεξεργαστής δεν τις εμφανίζει και οι εφαρμογές τους μετακινούνται στην προεπιλεγμένη ζώνη της οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que una disposición tenga zonas más allá de los bordes izquierdo y derecho de la pantalla. Se llega a ellas con los atajos de desplazamiento (consulta Atajos) o desplazándote sobre la isla de la barra de menús. Si se desactiva, el editor no las muestra y sus apps pasan a la zona predeterminada de la pantalla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lubab paigutusel olla tsoone ekraani vasaku ja parema serva taga. Nendeni jõuab kerimise kiirklahvidega (vt Kiirklahvid) või menüüribal oleva saare kohal kerides. Väljalülitatuna redaktor neid ei näita ja nende rakendused liiguvad ekraani vaiketsooni."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به یک چیدمان اجازه می‌دهد ناحیه‌هایی فراتر از لبه‌های چپ و راست صفحه‌نمایش داشته باشد. با میان‌برهای پیمایش (به میان‌برها نگاه کنید) یا با پیمایش روی جزیره در نوار منو می‌توانید به آن‌ها برسید. اگر خاموش باشد، ویرایشگر آن‌ها را نشان نمی‌دهد و برنامه‌هایشان به ناحیهٔ پیش‌فرض صفحه‌نمایش منتقل می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallii asettelulle alueita näytön vasemman ja oikean reunan takana. Niihin pääsee vierityspikanäppäimillä (katso Pikanäppäimet) tai vierittämällä valikkorivin saaren päällä. Kun asetus on pois päältä, editori ei näytä alueita ja niiden apit siirtyvät näytön oletusalueelle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapayagan ang isang layout na magkaroon ng mga zone lampas sa kaliwa at kanang gilid ng screen. Maaabot ang mga ito gamit ang mga scroll shortcut (tingnan ang Mga shortcut), o sa pag-scroll sa ibabaw ng island sa menu bar. Kapag naka-off, hindi ipinapakita ng editor ang mga ito at lilipat ang kanilang mga app sa default na zone ng screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à une disposition d'avoir des zones au-delà des bords gauche et droit de l'écran. On y accède avec les raccourcis de défilement (voir Raccourcis) ou en faisant défiler au-dessus de l'îlot de la barre des menus. Désactivé, l'éditeur ne les affiche pas et leurs apps passent dans la zone par défaut de l'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר לפריסה לכלול אזורים מעבר לקצה השמאלי והימני של המסך. אפשר להגיע אליהם בעזרת קיצורי הגלילה (ראה קיצורי דרך) או בגלילה מעל האי בשורת התפריטים. כשהאפשרות כבויה, העורך אינו מציג אותם והאפליקציות שלהם עוברות לאזור ברירת המחדל של המסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी लेआउट को स्क्रीन के बाएँ और दाएँ किनारों से परे ज़ोन रखने देता है। उन तक स्क्रॉल शॉर्टकट (देखें शॉर्टकट) से, या मेनू बार के आइलैंड पर स्क्रॉल करके पहुँचा जा सकता है। बंद होने पर एडिटर उन्हें नहीं दिखाता और उनके ऐप स्क्रीन के डिफ़ॉल्ट ज़ोन में चले जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje rasporedu zone izvan lijevog i desnog ruba zaslona. Do njih se dolazi prečacima za pomicanje (vidi Prečaci) ili pomicanjem iznad otoka u traci izbornika. Kad je isključeno, uređivač ih ne prikazuje, a njihove se aplikacije premještaju u zadanu zonu zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi, hogy az elrendezésnek legyenek zónái a képernyő bal és jobb széle mögött. Ezeket a görgetési billentyűparancsokkal (lásd Billentyűparancsok) vagy a menüsor szigete fölötti görgetéssel éred el. Kikapcsolva a szerkesztő nem mutatja őket, az alkalmazásaik pedig a képernyő alapértelmezett zónájába kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memungkinkan tata letak memiliki zona di luar tepi kiri dan kanan layar. Zona itu dijangkau dengan pintasan gulir (lihat Pintasan), atau dengan menggulir di atas pulau di bilah menu. Jika dimatikan, editor tidak menampilkannya dan app di dalamnya pindah ke zona default layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette a un layout di avere zone oltre i bordi sinistro e destro dello schermo. Si raggiungono con le scorciatoie di scorrimento (vedi Scorciatoie) o scorrendo sopra l'isola nella barra dei menu. Se disattivato, l'editor non le mostra e le loro app passano alla zona predefinita dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトに、画面の左右の端の外側にあるゾーンを持たせます。スクロールのショートカット（「ショートカット」を参照）や、メニューバーのアイランド上でのスクロールで移動できます。オフにすると、エディタにはそれらのゾーンが表示されず、そのアプリは画面のデフォルトのゾーンに移ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이아웃이 화면의 왼쪽과 오른쪽 가장자리 밖에 영역을 가질 수 있게 합니다. 스크롤 단축키(단축키 참조)나 메뉴 막대의 아일랜드 위에서 스크롤하여 이동할 수 있습니다. 끄면 편집기에 해당 영역이 표시되지 않으며, 그 영역의 앱은 화면의 기본 영역으로 이동합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leidžia išdėstymui turėti zonų už kairiojo ir dešiniojo ekrano krašto. Jas pasiekiate slinkimo spartieji klavišais (žr. Spartieji klavišai) arba slinkdami virš salos meniu juostoje. Kai išjungta, redaktorius jų nerodo, o jų programos perkeliamos į numatytąją ekrano zoną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļauj izkārtojumam būt zonām aiz ekrāna kreisās un labās malas. Tām var piekļūt ar ritināšanas īsinājumtaustiņiem (skatiet Īsinājumtaustiņi) vai ritinot virs salas izvēlņu joslā. Ja izslēgts, redaktors tās nerāda, un to lietotnes pāriet uz ekrāna noklusējuma zonu."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेआउटला स्क्रीनच्या डाव्या आणि उजव्या कडांच्या पलीकडे झोन ठेवू देते. स्क्रोल शॉर्टकटने (शॉर्टकट पहा) किंवा मेनू बारमधील आयलंडवर स्क्रोल करून त्यांपर्यंत पोहोचता येते. बंद केल्यास एडिटर ते दाखवत नाही आणि त्यांचे अ‍ॅप स्क्रीनच्या डीफॉल्ट झोनमध्ये जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membolehkan reka letak mempunyai zon di luar tepi kiri dan kanan skrin. Zon itu boleh dicapai dengan pintasan tatal (lihat Pintasan), atau dengan menatal di atas pulau dalam bar menu. Jika dimatikan, editor tidak menunjukkannya dan apl di dalamnya berpindah ke zon lalai skrin."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar et layout ha soner utenfor skjermens venstre og høyre kant. Du når dem med rullesnarveiene (se Snarveier) eller ved å rulle over øya i menylinjen. Når det er slått av, viser ikke editoren dem, og appene deres flyttes til skjermens standardsone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een indeling zones hebben voorbij de linker- en rechterrand van het scherm. Je bereikt ze met de scrolltoetsen (zie Sneltoetsen) of door te scrollen boven het eiland in de menubalk. Als dit uit staat, toont de editor ze niet en gaan hun apps naar de standaardzone van het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala układowi mieć strefy poza lewą i prawą krawędzią ekranu. Dotrzesz do nich skrótami przewijania (zobacz Skróty) lub przewijając nad wyspą na pasku menu. Gdy opcja jest wyłączona, edytor ich nie pokazuje, a ich aplikacje przechodzą do domyślnej strefy ekranu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que uma disposição tenha zonas para lá dos limites esquerdo e direito do ecrã. Chega-se a elas com os atalhos de deslocamento (consulte Atalhos) ou deslocando sobre a ilha na barra de menus. Se estiver desativado, o editor não as mostra e as suas apps passam para a zona predefinida do ecrã."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que um layout tenha zonas além das bordas esquerda e direita da tela. Você chega a elas com os atalhos de rolagem (veja Atalhos) ou rolando sobre a ilha na barra de menus. Se estiver desativado, o editor não as mostra e os apps delas vão para a zona padrão da tela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite unui aspect să aibă zone dincolo de marginile stângă și dreaptă ale ecranului. Le poți atinge cu comenzile rapide de derulare (vezi Comenzi rapide) sau derulând deasupra insulei din bara de meniu. Când este oprit, editorul nu le afișează, iar aplicațiile lor trec în zona implicită a ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет раскладке иметь зоны за левым и правым краями экрана. До них можно добраться сочетаниями клавиш прокрутки (см. «Сочетания клавиш») или прокруткой над островом в строке меню. Если выключено, редактор их не показывает, а их приложения переходят в зону экрана по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje, aby rozloženie malo zóny za ľavým a pravým okrajom obrazovky. K nim sa dostanete skratkami na posúvanie (pozri Skratky) alebo posúvaním nad ostrovom v paneli ponúk. Keď je vypnuté, editor ich nezobrazuje a ich aplikácie sa presunú do predvolenej zóny obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavitvi omogoča, da ima območja onkraj levega in desnega roba zaslona. Do njih pridete z bližnjicami za pomikanje (glejte Bližnjice) ali s pomikanjem nad otokom v menijski vrstici. Če je izklopljeno, jih urejevalnik ne prikazuje, njihove aplikacije pa se premaknejo v privzeto območje zaslona."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућава распореду да има зоне изван левог и десног руба екрана. До њих се стиже пречицама за померање (погледајте Пречице) или померањем изнад острва у траци менија. Када је искључено, уређивач их не приказује, а њихове апликације прелазе у подразумевану зону екрана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter en layout ha zoner bortom skärmens vänstra och högra kant. Du når dem med rullningsgenvägarna (se Kortkommandon) eller genom att rulla över ön i menyraden. När det är av visar redigeraren dem inte, och deras appar flyttas till skärmens standardzon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு தளவமைப்பு திரையின் இடது, வலது விளிம்புகளுக்கு அப்பால் மண்டலங்களைக் கொண்டிருக்க அனுமதிக்கிறது. உருள் குறுக்குவழிகள் (குறுக்குவழிகளைப் பார்க்கவும்) மூலமாகவோ, மெனு பட்டியில் உள்ள தீவின் மேல் உருட்டியோ அவற்றை அடையலாம். அணைத்திருந்தால் எடிட்டர் அவற்றைக் காட்டாது, அவற்றின் பயன்பாடுகள் திரையின் இயல்புநிலை மண்டலத்துக்கு நகரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లేఅవుట్‌కు స్క్రీన్ ఎడమ, కుడి అంచులకు ఆవల జోన్‌లు ఉండేలా అనుమతిస్తుంది. స్క్రోల్ షార్ట్‌కట్‌ల ద్వారా (షార్ట్‌కట్‌లు చూడండి) లేదా మెనూ బార్‌లోని ఐలాండ్ పైన స్క్రోల్ చేసి వాటిని చేరుకోవచ్చు. ఆఫ్ చేస్తే ఎడిటర్ వాటిని చూపదు, వాటి యాప్‌లు స్క్రీన్ డిఫాల్ట్ జోన్‌కు మారతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้เลย์เอาต์มีโซนอยู่เลยขอบซ้ายและขอบขวาของหน้าจอได้ เข้าถึงโซนเหล่านั้นด้วยทางลัดเลื่อน (ดูทางลัด) หรือเลื่อนบนไอส์แลนด์ในแถบเมนู เมื่อปิดอยู่ ตัวแก้ไขจะไม่แสดงโซนเหล่านั้น และแอปในโซนจะย้ายไปที่โซนเริ่มต้นของหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir düzenin ekranın sol ve sağ kenarlarının ötesinde bölgeler içermesine izin verir. Bunlara kaydırma kısayollarıyla (bkz. Kısayollar) ya da menü çubuğundaki adanın üzerinde kaydırarak ulaşılır. Kapalıyken düzenleyici bunları göstermez ve uygulamaları ekranın varsayılan bölgesine taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дає змогу розкладці мати зони за лівим і правим краями екрана. До них можна дістатися скороченнями прокручування (див. «Скорочення») або прокручуванням над островом у рядку меню. Якщо вимкнено, редактор їх не показує, а їхні програми переходять у зону екрана за замовчуванням."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لے آؤٹ کو اسکرین کے بائیں اور دائیں کناروں سے آگے زونز رکھنے دیتا ہے۔ ان تک اسکرول شارٹ کٹس (شارٹ کٹس دیکھیں) سے، یا مینو بار میں جزیرے پر اسکرول کر کے پہنچا جا سکتا ہے۔ بند ہونے پر ایڈیٹر انہیں نہیں دکھاتا اور ان کی ایپس اسکرین کے ڈیفالٹ زون میں چلی جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép một bố cục có các vùng nằm ngoài mép trái và mép phải của màn hình. Bạn đến các vùng đó bằng phím tắt cuộn (xem Phím tắt) hoặc bằng cách cuộn trên đảo trong thanh menu. Khi tắt, trình chỉnh sửa không hiển thị các vùng đó và ứng dụng của chúng chuyển sang vùng mặc định của màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许布局拥有位于屏幕左右边缘之外的区域。可以通过滚动快捷键（见“快捷键”）或在菜单栏的岛上滚动来到达这些区域。关闭后，编辑器不再显示它们，其中的应用会移到屏幕的默认区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許版面配置擁有位於螢幕左右邊緣之外的區域。可以透過捲動快速鍵（見「快速鍵」）或在選單列的島上捲動來到達這些區域。關閉後，編輯器不再顯示它們，其中的 App 會移到螢幕的預設區域。"
          }
        }
      }
    },
