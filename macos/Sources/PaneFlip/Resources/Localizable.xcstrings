        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip ला विंडोचे चित्र घेऊ देते, जेणेकरून ती तिच्या झोनमध्ये दुसऱ्या विंडोच्या शेजारी सरकून येऊ शकेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membenarkan PaneFlip mengambil gambar tetingkap supaya ia boleh meluncur di sebelah tetingkap lain dalam zonnya."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar PaneFlip ta et bilde av et vindu, slik at det kan gli inn ved siden av et annet innenfor sin sone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat PaneFlip een beeld van een venster maken, zodat het binnen zijn zone naast een ander venster kan schuiven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala PaneFlip zrobić obraz okna, aby mogło wsunąć się obok innego okna w swojej strefie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o PaneFlip tire uma imagem de uma janela para que ela possa deslizar para junto de outra dentro da sua zona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o PaneFlip tire uma imagem de uma janela para que ela possa deslizar para o lado de outra dentro da sua zona."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite PaneFlip să facă o imagine a unei ferestre, astfel încât aceasta să poată aluneca lângă o altă fereastră în zona ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет PaneFlip делать снимок окна, чтобы оно могло плавно выехать рядом с другим окном внутри своей зоны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip urobiť snímku okna, aby sa mohlo vsunúť vedľa iného okna vo svojej zóne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoča PaneFlipu, da posname sliko okna, da lahko zdrsi ob drugo okno znotraj svojega območja."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућава PaneFlip-у да направи слику прозора како би могао да клизне поред другог прозора унутар своје зоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter PaneFlip ta en bild av ett fönster så att det kan glida in bredvid ett annat inom sin zon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip-ஐ ஒரு சாளரத்தின் படத்தை எடுக்க அனுமதிக்கிறது, அதனால் அது தனது மண்டலத்திற்குள் மற்றொரு சாளரத்தின் அருகே நகர்ந்து வர முடியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip‌ను ఒక విండో చిత్రాన్ని తీసుకోవడానికి అనుమతిస్తుంది, తద్వారా అది తన జోన్‌లో మరో విండో పక్కకు జారి రాగలదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ PaneFlip ถ่ายภาพหน้าต่าง เพื่อให้เลื่อนมาอยู่ข้างหน้าต่างอื่นภายในโซนของตัวเองได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip'in bir pencerenin görüntüsünü almasına izin verir; böylece pencere, bölgesi içinde başka bir pencerenin yanına kayarak gelebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє PaneFlip робити знімок вікна, щоб воно могло плавно виїхати поруч з іншим вікном у межах своєї зони."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip کو کسی ونڈو کی تصویر لینے دیتا ہے تاکہ وہ اپنے زون کے اندر دوسری ونڈو کے ساتھ سرک کر آ سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép PaneFlip chụp ảnh một cửa sổ để nó có thể trượt vào cạnh một cửa sổ khác trong vùng của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 PaneFlip 获取窗口的图像，以便该窗口在其区域内滑入另一个窗口旁边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 PaneFlip 取得視窗的影像，以便該視窗在其區域內滑入另一個視窗旁邊。"
          }
        }
      }
    },
    "Lets a layout have zones beyond the left and right edges of a screen, reached by scrolling: with three fingers on the trackpad, or by moving the pointer to the screen's edge. Switched off, the editor does not show them and their apps move to the default zone of the screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح للتخطيط أن تكون له مناطق خلف الحافتين اليسرى واليمنى للشاشة يُوصَل إليها بالتمرير: بثلاثة أصابع على لوحة التتبع أو بتحريك المؤشر إلى حافة الشاشة. عند الإيقاف لا يعرضها المحرر وتنتقل تطبيقاتها إلى المنطقة الافتراضية للشاشة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на оформлението да има зони извън левия и десния край на екрана, до които се стига с превъртане: с три пръста на тракпада или като преместите показалеца до края на екрана. Когато е изключено, редакторът не ги показва, а приложенията им се преместват в зоната по подразбиране на екрана."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেআউটকে স্ক্রিনের বাঁ ও ডান প্রান্তের বাইরে জোন রাখতে দেয়, যেখানে স্ক্রল করে পৌঁছানো যায়: ট্র্যাকপ্যাডে তিন আঙুলে বা পয়েন্টার স্ক্রিনের প্রান্তে নিয়ে। বন্ধ থাকলে এডিটর সেগুলো দেখায় না এবং সেগুলোর অ্যাপ স্ক্রিনের ডিফল্ট জোনে চলে যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que una disposició tingui zones més enllà de les vores esquerra i dreta d'una pantalla, a les quals s'arriba desplaçant: amb tres dits al trackpad o portant el punter a la vora de la pantalla. Si es desactiva, l'editor no les mostra i les seves apps passen a la zona predeterminada de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní rozložení mít zóny za levým a pravým okrajem obrazovky, k nimž se dostanete posouváním: třemi prsty na trackpadu nebo přesunutím ukazatele k okraji obrazovky. Když je vypnuto, editor je nezobrazuje a jejich aplikace se přesunou do výchozí zóny obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader et layout have zoner uden for skærmens venstre og højre kant, som nås ved at rulle: med tre fingre på pegefeltet eller ved at flytte markøren til skærmkanten. Når det er slået fra, viser editoren dem ikke, og deres apps flyttes til skærmens standardzone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt einem Layout Zonen jenseits des linken und rechten Bildschirmrands, die du durch Scrollen erreichst: mit drei Fingern auf dem Trackpad oder indem du den Zeiger an den Bildschirmrand bewegst. Ausgeschaltet zeigt der Editor sie nicht an, und ihre Apps wandern in die Standardzone des Bildschirms."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει σε μια διάταξη να έχει ζώνες πέρα από την αριστερή και τη δεξιά άκρη μιας οθόνης, στις οποίες φτάνετε με κύλιση: με τρία δάχτυλα στην επιφάνεια αφής ή μετακινώντας τον δείκτη στην άκρη της οθόνης. Όταν είναι απενεργοποιημένο, ο επεξεργαστής δεν τις εμφανίζει και οι εφαρμογές τους μεταφέρονται στην προεπιλεγμένη ζώνη της οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que una disposición tenga zonas más allá de los bordes izquierdo y derecho de una pantalla, a las que se llega desplazando: con tres dedos en el trackpad o llevando el puntero al borde de la pantalla. Si se desactiva, el editor no las muestra y sus apps pasan a la zona predeterminada de la pantalla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lubab paigutusel olla tsoone ekraani vasaku ja parema serva taga, milleni jõuab kerides: kolme sõrmega puuteplaadil või kursori ekraani serva viimisega. Väljalülitatuna redaktor neid ei näita ja nende rakendused liiguvad ekraani vaiketsooni."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به چیدمان اجازه می‌دهد فراتر از لبه‌های چپ و راست صفحه ناحیه داشته باشد که با پیمایش به آن‌ها می‌رسید: با سه انگشت روی ترک‌پد یا با بردن نشانگر به لبهٔ صفحه. وقتی خاموش باشد ویرایشگر آن‌ها را نشان نمی‌دهد و برنامه‌هایشان به ناحیهٔ پیش‌فرض صفحه منتقل می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallii asettelulle alueita näytön vasemman ja oikean reunan ulkopuolella, joihin pääsee vierittämällä: kolmella sormella ohjauslevyllä tai viemällä osoittimen näytön reunaan. Kun asetus on pois päältä, editori ei näytä alueita ja niiden appit siirtyvät näytön oletusalueeseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapayagan ang isang layout na magkaroon ng mga zone lampas sa kaliwa at kanang gilid ng screen, na naaabot sa pag-scroll: gamit ang tatlong daliri sa trackpad o sa paglipat ng pointer sa gilid ng screen. Kapag naka-off, hindi ito ipinapakita ng editor at ang mga app nito ay lilipat sa default na zone ng screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à une disposition d'avoir des zones au-delà des bords gauche et droit d'un écran, atteintes par défilement : avec trois doigts sur le trackpad ou en amenant le pointeur au bord de l'écran. Désactivé, l'éditeur ne les affiche pas et leurs apps passent dans la zone par défaut de l'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר לפריסה להכיל אזורים מעבר לקצוות השמאלי והימני של מסך, שמגיעים אליהם בגלילה: בשלוש אצבעות על משטח המגע או על ידי הזזת המצביע לקצה המסך. כשהאפשרות כבויה העורך אינו מציג אותם והאפליקציות שבהם עוברות לאזור ברירת המחדל של המסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेआउट को स्क्रीन के बाएँ और दाएँ किनारों के बाहर ज़ोन रखने देता है, जहाँ स्क्रोल करके पहुँचा जाता है: ट्रैकपैड पर तीन उँगलियों से या पॉइंटर को स्क्रीन के किनारे ले जाकर। बंद होने पर एडिटर उन्हें नहीं दिखाता और उनके ऐप स्क्रीन के डिफ़ॉल्ट ज़ोन में चले जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje rasporedu zone izvan lijevog i desnog ruba zaslona, kojima se pristupa pomicanjem: s tri prsta na trackpadu ili pomicanjem pokazivača na rub zaslona. Kad je isključeno, uređivač ih ne prikazuje, a njihove aplikacije prelaze u zadanu zonu zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi, hogy egy elrendezésnek legyenek zónái a képernyő bal és jobb szélén túl, amelyeket görgetéssel ér el: három ujjal a trackpaden, vagy a mutatót a képernyő szélére víve. Kikapcsolva a szerkesztő nem mutatja őket, és az alkalmazásaik a képernyő alapértelmezett zónájába kerülnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memungkinkan tata letak memiliki zona di luar tepi kiri dan kanan layar, yang dijangkau dengan menggulir: dengan tiga jari di trackpad atau dengan membawa penunjuk ke tepi layar. Saat dimatikan, editor tidak menampilkannya dan aplikasinya dipindahkan ke zona default layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette a un layout di avere zone oltre i bordi sinistro e destro di uno schermo, raggiunte scorrendo: con tre dita sul trackpad o portando il puntatore al bordo dello schermo. Se disattivato, l'editor non le mostra e le loro app passano alla zona predefinita dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトに、画面の左右の端の外側にスクロールで移動するゾーンを持たせます。トラックパッドの3本指、またはポインタを画面の端に動かして移動します。オフにすると、エディタには表示されず、中のアプリは画面のデフォルトのゾーンに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이아웃이 화면 왼쪽과 오른쪽 가장자리 밖에 영역을 가질 수 있게 하며, 스크롤하여 이동합니다. 트랙패드에서 세 손가락으로 하거나 포인터를 화면 가장자리로 옮기면 됩니다. 끄면 편집기에 표시되지 않고 그 안의 앱은 화면의 기본 영역으로 이동합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leidžia išdėstymui turėti zonų už kairiojo ir dešiniojo ekrano krašto, kurias pasiekiama slenkant: trimis pirštais liečiamuoju kilimėliu arba nuvedus žymeklį į ekrano kraštą. Išjungus redaktorius jų nerodo, o jų programos perkeliamos į numatytąją ekrano zoną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļauj izkārtojumam būt zonām aiz ekrāna kreisās un labās malas, kurām piekļūst ar ritināšanu: ar trim pirkstiem uz skārienpaliktņa vai pārvietojot rādītāju uz ekrāna malu. Kad izslēgts, redaktors tās nerāda, un to lietotnes pārvietojas uz ekrāna noklusējuma zonu."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेआउटला स्क्रीनच्या डाव्या आणि उजव्या कडांबाहेर झोन ठेवू देते, ज्यांच्यापर्यंत स्क्रोल करून पोहोचता येते: ट्रॅकपॅडवर तीन बोटांनी किंवा पॉइंटर स्क्रीनच्या कडेला नेऊन. बंद असताना एडिटर ते दाखवत नाही आणि त्यांतील ॲप्स स्क्रीनच्या डीफॉल्ट झोनमध्ये जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membolehkan reka letak mempunyai zon di luar tepi kiri dan kanan skrin, yang dicapai dengan menatal: dengan tiga jari pada pad jejak atau dengan membawa penuding ke tepi skrin. Apabila dimatikan, editor tidak menunjukkannya dan aplikasinya dialihkan ke zon lalai skrin."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar en layout ha soner utenfor skjermens venstre og høyre kant, som nås ved å rulle: med tre fingre på styreflaten eller ved å flytte pekeren til skjermkanten. Når det er slått av, viser ikke redigeringsprogrammet dem, og appene deres flyttes til skjermens standardsone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een indeling zones hebben voorbij de linker- en rechterrand van een scherm, die je bereikt door te scrollen: met drie vingers op het trackpad of door de aanwijzer naar de schermrand te bewegen. Uitgeschakeld toont de editor ze niet en gaan hun apps naar de standaardzone van het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala układowi mieć strefy poza lewą i prawą krawędzią ekranu, do których dochodzi się przewijaniem: trzema palcami na gładziku lub przesunięciem wskaźnika do krawędzi ekranu. Po wyłączeniu edytor ich nie pokazuje, a ich aplikacje trafiają do strefy domyślnej ekranu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que uma disposição tenha zonas para além das bordas esquerda e direita de um ecrã, alcançadas por deslocamento: com três dedos no trackpad ou levando o ponteiro à borda do ecrã. Desativado, o editor não as mostra e as suas apps passam para a zona predefinida do ecrã."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que um layout tenha zonas além das bordas esquerda e direita de uma tela, alcançadas por rolagem: com três dedos no trackpad ou levando o ponteiro à borda da tela. Desativado, o editor não as mostra e os apps delas vão para a zona padrão da tela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite unui aspect să aibă zone dincolo de marginile stângă și dreaptă ale unui ecran, la care se ajunge prin derulare: cu trei degete pe trackpad sau mutând cursorul la marginea ecranului. Dezactivat, editorul nu le arată, iar aplicațiile lor trec în zona implicită a ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет раскладке иметь зоны за левым и правым краями экрана, к которым переходят прокруткой: тремя пальцами на трекпаде или подведя указатель к краю экрана. Если выключено, редактор их не показывает, а их приложения переходят в зону экрана по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožní rozloženiu mať zóny za ľavým a pravým okrajom obrazovky, ku ktorým sa dostanete posúvaním: tromi prstami na trackpade alebo presunutím ukazovateľa k okraju obrazovky. Keď je vypnuté, editor ich nezobrazuje a ich aplikácie sa presunú do predvolenej zóny obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavitvi omogoči območja zunaj levega in desnega roba zaslona, do katerih pridete s pomikanjem: s tremi prsti na sledilni ploščici ali s premikom kazalca na rob zaslona. Če je izklopljeno, jih urejevalnik ne prikaže in njihove aplikacije se premaknejo v privzeto območje zaslona."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућава распореду зоне изван леве и десне ивице екрана, до којих се долази померањем: са три прста на трекпеду или померањем показивача на ивицу екрана. Када је искључено, уређивач их не приказује, а њихове апликације прелазе у подразумевану зону екрана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter en layout ha zoner utanför skärmens vänstra och högra kant, som nås genom att rulla: med tre fingrar på styrplattan eller genom att flytta pekaren till skärmkanten. När det är avstängt visar redigeraren dem inte och deras appar flyttas till skärmens standardzon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தளவமைப்பு, திரையின் இடது மற்றும் வலது ஓரங்களுக்கு வெளியே மண்டலங்களைக் கொண்டிருக்க அனுமதிக்கிறது; அவற்றை உருட்டி அடையலாம்: டிராக்பேடில் மூன்று விரல்களால் அல்லது சுட்டியைத் திரையின் ஓரத்துக்குக் கொண்டு சென்று. அணைத்தால் எடிட்டர் அவற்றைக் காட்டாது, அவற்றில் உள்ள ஆப்ஸ் திரையின் இயல்புநிலை மண்டலத்துக்கு நகரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లేఅవుట్‌కు స్క్రీన్ ఎడమ మరియు కుడి అంచుల వెలుపల జోన్‌లు ఉండటానికి అనుమతిస్తుంది; వాటికి స్క్రోల్ చేసి చేరుకోవచ్చు: ట్రాక్‌ప్యాడ్‌పై మూడు వేళ్లతో లేదా పాయింటర్‌ను స్క్రీన్ అంచుకు తీసుకెళ్లి. ఆఫ్‌లో ఉంటే ఎడిటర్ వాటిని చూపదు, వాటిలోని యాప్‌లు స్క్రీన్ డిఫాల్ట్ జోన్‌కు తరలిపోతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้เลย์เอาต์มีโซนนอกขอบซ้ายและขวาของหน้าจอ ซึ่งเข้าถึงได้ด้วยการเลื่อน: ใช้สามนิ้วบนแทร็กแพดหรือเลื่อนพอยน์เตอร์ไปที่ขอบหน้าจอ เมื่อปิด ตัวแก้ไขจะไม่แสดงโซนเหล่านั้น และแอปในโซนจะย้ายไปยังโซนเริ่มต้นของหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir düzenin, ekranın sol ve sağ kenarlarının ötesinde bölgeleri olmasını sağlar; bunlara kaydırarak ulaşılır: izleme dörtgeninde üç parmakla ya da imleci ekran kenarına götürerek. Kapalıyken düzenleyici bunları göstermez ve içlerindeki uygulamalar ekranın varsayılan bölgesine taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє розкладці мати зони за лівим і правим краями екрана, до яких доходять прокручуванням: трьома пальцями на трекпаді або підвівши вказівник до краю екрана. Якщо вимкнено, редактор їх не показує, а їхні програми переходять до зони екрана за замовчуванням."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لے آؤٹ کو اسکرین کے بائیں اور دائیں کناروں سے باہر زونز رکھنے دیتا ہے جن تک اسکرول کر کے پہنچا جاتا ہے: ٹریک پیڈ پر تین انگلیوں سے یا پوائنٹر کو اسکرین کے کنارے تک لے جا کر۔ بند ہونے پر ایڈیٹر انہیں نہیں دکھاتا اور ان کی ایپس اسکرین کے ڈیفالٹ زون میں چلی جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép bố cục có các vùng ngoài cạnh trái và phải của màn hình, đến được bằng cách cuộn: bằng ba ngón tay trên bàn di chuột hoặc đưa con trỏ tới cạnh màn hình. Khi tắt, trình chỉnh sửa không hiển thị chúng và các ứng dụng trong đó được chuyển sang vùng mặc định của màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让布局在屏幕左右边缘之外拥有区域,通过滚动到达:在触控板上用三指,或把指针移到屏幕边缘。关闭后,编辑器不再显示这些区域,其中的 App 会移到该屏幕的默认区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓版面配置在螢幕左右邊緣之外擁有區域,透過捲動到達:在觸控式軌跡板上用三指,或將指標移到螢幕邊緣。關閉後,編輯器不再顯示這些區域,其中的 App 會移到該螢幕的預設區域。"
          }
        }
      }
    },
