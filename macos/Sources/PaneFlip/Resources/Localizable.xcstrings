    },
    "Several apps share a zone and you switch between them with the pill. When off, a zone holds one app and a new one replaces it." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölgeyi birkaç uygulama paylaşır ve aralarında hap ile geçiş yaparsın. Kapalıyken, bir bölge tek bir uygulama tutar ve yeni uygulama onun yerine geçer."
          }
        }
      }
    },
    "Shortcuts" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar"
          }
        }
      }
    },
