    "Not set yet. Until you move a display, PaneFlip uses the arrangement in macOS." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُضبط بعد. إلى أن تنقل إحدى الشاشات، يستخدم PaneFlip الترتيب في macOS."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Още не е зададена. Докато не преместите дисплей, PaneFlip използва подредбата в macOS."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনও সেট করা হয়নি। কোনো ডিসপ্লে সরানো পর্যন্ত PaneFlip macOS-এর বিন্যাস ব্যবহার করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no s’ha definit. Fins que moguis una pantalla, PaneFlip fa servir la disposició de macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
