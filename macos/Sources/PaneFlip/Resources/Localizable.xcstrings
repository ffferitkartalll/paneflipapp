        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas telas estão no mesmo nível da tela à sua esquerda, então uma zona além da borda de uma cai na outra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
