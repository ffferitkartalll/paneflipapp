    "The displays do not form a staircase yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشاشات لا تشكّل درجًا بعد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплеите още не образуват стълба."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিসপ্লেগুলো এখনও সিঁড়ি তৈরি করেনি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pantalles encara no formen una escala."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displeje zatím netvoří schody."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmene danner ikke en trappe endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Displays bilden noch keine Treppe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οθόνες δεν σχηματίζουν ακόμη σκάλα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas aún no forman una escalera."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekraanid ei moodusta veel treppi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایشگرها هنوز پله تشکیل نمی‌دهند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytöt eivät vielä muodosta portaita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa bumubuo ng hagdan ang mga display."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans ne forment pas encore un escalier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגים עדיין לא יוצרים מדרגות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले अभी सीढ़ी नहीं बनाते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasloni još ne tvore stepenice."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelzők még nem alkotnak lépcsőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar belum membentuk tangga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schermi non formano ancora una scala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイはまだ階段状になっていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이가 아직 계단 모양이 아닙니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranai dar nesudaro laiptų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displeji vēl neveido kāpnes."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले अजून जिना तयार करत नाहीत."
          }
        },
        "ms" : {
