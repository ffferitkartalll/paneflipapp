    "Some displays are level with the one to their left, so a zone beyond the edge of one lands on the other." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض الشاشات في مستوى الشاشة التي على يسارها، لذا تنتقل المنطقة التي تتجاوز حافة إحداها إلى الأخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Някои дисплеи са на едно ниво с този отляво, затова зона отвъд ръба на единия попада върху другия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু ডিসপ্লে তাদের বাঁ দিকের ডিসপ্লের সমান উচ্চতায় আছে, তাই একটির প্রান্তের বাইরের জোন অন্যটিতে গিয়ে পড়ে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunes pantalles estan al mateix nivell que la que tenen a l’esquerra, de manera que una zona més enllà de la vora d’una cau a l’altra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé displeje jsou ve stejné výšce jako displej vlevo od nich, takže zóna za okrajem jednoho dopadne na druhý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle skærme er i niveau med skærmen til venstre, så en zone uden for kanten af den ene havner på den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Displays liegen auf gleicher Höhe wie das Display links davon, sodass eine Zone jenseits des Rands des einen auf dem anderen landet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένες οθόνες βρίσκονται στο ίδιο ύψος με την οθόνη στα αριστερά τους, οπότε μια ζώνη πέρα από την άκρη της μίας πέφτει στην άλλη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas pantallas están al mismo nivel que la que tienen a su izquierda, así que una zona más allá del borde de una cae en la otra."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõned ekraanid on samal kõrgusel nende vasakpoolse ekraaniga, nii et ühe ekraani serva taha jääv tsoon satub teisele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعضی نمایشگرها هم‌سطح نمایشگر سمت چپ خود هستند، بنابراین ناحیه‌ای که فراتر از لبهٔ یکی است روی دیگری می‌افتد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin näytöt ovat samalla korkeudella vasemmalla olevan näytön kanssa, joten toisen reunan ulkopuolella oleva alue osuu toiselle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May mga display na magkapantay sa display sa kaliwa nila, kaya ang zone na lampas sa gilid ng isa ay napupunta sa isa pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains écrans sont au même niveau que celui à leur gauche : une zone au-delà du bord de l’un tombe donc sur l’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלק מהצגים נמצאים באותה גובה עם הצג משמאלם, ולכן אזור שמעבר לקצה של אחד מהם נוחת על האחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ डिस्प्ले अपने बाईं ओर वाले डिस्प्ले के बराबर ऊँचाई पर हैं, इसलिए एक के किनारे से आगे का ज़ोन दूसरे पर आ जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neki su zasloni u istoj visini kao zaslon lijevo od njih pa zona iza ruba jednoga završi na drugom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyes kijelzők a tőlük balra lévővel azonos szinten vannak, ezért az egyik szélén túli zóna a másikra esik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa layar sejajar dengan layar di sebelah kirinya, sehingga zona di luar tepi salah satunya jatuh ke layar yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni schermi sono allo stesso livello di quello alla loro sinistra, quindi una zona oltre il bordo di uno finisce sull’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左隣のディスプレイと同じ高さにあるディスプレイがあるため、一方の端の外にあるゾーンがもう一方に重なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 디스플레이가 왼쪽 디스플레이와 같은 높이에 있어서, 한쪽 가장자리 밖의 영역이 다른 쪽에 놓입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai kurie ekranai yra tame pačiame lygyje kaip jų kairėje esantis ekranas, todėl zona už vieno krašto patenka ant kito."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daži displeji atrodas vienā līmenī ar displeju to kreisajā pusē, tāpēc zona aiz viena malas nokļūst uz otra."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काही डिस्प्ले त्यांच्या डावीकडील डिस्प्लेइतक्याच उंचीवर आहेत, त्यामुळे एकाच्या काठाच्या पलीकडील झोन दुसऱ्यावर येतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesetengah paparan sejajar dengan paparan di sebelah kirinya, jadi zon di luar tepi salah satunya jatuh pada yang lain."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen skjermer er på samme nivå som skjermen til venstre for dem, så en sone utenfor kanten på den ene havner på den andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige schermen staan op gelijke hoogte met het scherm links ervan, waardoor een zone voorbij de rand van het ene op het andere terechtkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre wyświetlacze są na tym samym poziomie co wyświetlacz po ich lewej, więc strefa poza krawędzią jednego trafia na drugi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns ecrãs estão ao mesmo nível do ecrã à sua esquerda, pelo que uma zona além da margem de um cai no outro."
          }
