    "Grant the access below in System Settings. This window updates as soon as you do." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları'nda aşağıdakilere erişim izni verin. Bu pencere siz yaptıkça güncellenecektir."
