    "Lets PaneFlip see the windows of other apps and move them into zones." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لـ PaneFlip رؤية نوافذ التطبيقات الأخرى ونقلها إلى المناطق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволява на PaneFlip да вижда прозорците на други приложения и да ги премества в зони."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PaneFlip-কে অন্য অ্যাপের উইন্ডো দেখতে এবং সেগুলোকে জোনে সরাতে দেয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que PaneFlip vegi les finestres d’altres apps i les mogui a zones."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožňuje PaneFlip vidět okna jiných aplikací a přesouvat je do zón."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader PaneFlip se andre apps’ vinduer og flytte dem ind i zoner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt PaneFlip, die Fenster anderer Apps zu sehen und in Zonen zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
