        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite pokazivač sekundu na lijevom ili desnom rubu zaslona da se prikažu zone iza tog ruba. Trackpad nije potreban."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa a mutatót egy másodpercig a képernyő bal vagy jobb szélén, hogy láthatóvá váljanak az azon a szélen túli zónák. Nincs szükség trackpadre."
