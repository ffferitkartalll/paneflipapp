    "How far the content goes for the same stroke of the fingers. It also follows the tracking speed set for the system's trackpad." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار تحرك المحتوى لنفس حركة الأصابع. يتبع أيضًا سرعة التتبع المضبوطة للوحة التتبع في النظام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колко се премества съдържанието при същото движение на пръстите. Следва и скоростта на проследяване, зададена за тракпада на системата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আঙুলের একই টানে কনটেন্ট কতটা সরবে। সিস্টেমের ট্র্যাকপ্যাডের ট্র্যাকিং গতিও এতে প্রভাব ফেলে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quant es mou el contingut amb el mateix gest dels dits. També segueix la velocitat de seguiment definida per al trackpad del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kolik se obsah posune při stejném tahu prsty. Řídí se také rychlostí sledování nastavenou pro trackpad v systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor langt indholdet flytter sig ved samme fingerbevægelse. Det følger også den sporingshastighed, der er indstillet for systemets pegefelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit sich der Inhalt bei gleicher Fingerbewegung bewegt. Es folgt auch der Trackinggeschwindigkeit, die für das Trackpad des Systems eingestellt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο μετακινείται το περιεχόμενο για την ίδια κίνηση των δαχτύλων. Ακολουθεί επίσης την ταχύτητα παρακολούθησης που έχει οριστεί για την επιφάνεια αφής του συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se mueve el contenido con el mismo gesto de los dedos. También sigue la velocidad de seguimiento definida para el trackpad del sistema."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui kaugele sisu liigub sama sõrmeliigutuse korral. See järgib ka süsteemi puuteplaadile seatud jälgimiskiirust."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتوا با همان حرکت انگشتان چقدر جابه‌جا شود. از سرعت ردیابی تنظیم‌شده برای تاچ‌پد سیستم هم پیروی می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka pitkälle sisältö liikkuu samalla sormiliikkeellä. Se seuraa myös järjestelmän ohjauslevylle asetettua seurantanopeutta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaano kalayo ang galaw ng content para sa parehong galaw ng mga daliri. Sumusunod din ito sa bilis ng pagsubaybay na itinakda para sa trackpad ng system."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien le contenu se déplace pour un même mouvement des doigts. Cela suit aussi la vitesse de suivi réglée pour le trackpad du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה התוכן זז עבור אותה תנועת אצבעות. זה גם עוקב אחר מהירות המעקב שהוגדרה למשטח העקיבה של המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उँगलियों की उसी गति पर सामग्री कितनी दूर जाती है। यह सिस्टम के ट्रैकपैड के लिए तय की गई ट्रैकिंग गति का भी पालन करती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko se sadržaj pomakne pri istom pokretu prstiju. Prati i brzinu praćenja postavljenu za trackpad sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyit mozdul a tartalom az ujjak azonos mozdulatára. Követi a rendszer érintőpadjához beállított követési sebességet is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa jauh konten bergerak untuk gerakan jari yang sama. Juga mengikuti kecepatan pelacakan yang diatur untuk trackpad sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di quanto si sposta il contenuto con lo stesso movimento delle dita. Segue anche la velocità di tracciamento impostata per il trackpad del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ指の動きでコンテンツがどれだけ動くかを設定します。システムのトラックパッドに設定された軌跡の速さにも従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 손가락 움직임에 콘텐츠가 얼마나 움직일지 정합니다. 시스템 트랙패드에 설정된 추적 속도도 따릅니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiek turinys pasislenka tokiu pat pirštų judesiu. Taip pat atsižvelgiama į sistemos jutiklinei planšetei nustatytą sekimo greitį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cik tālu pārvietojas saturs ar to pašu pirkstu kustību. Tiek ņemts vērā arī sistēmas skārienpaliktnim iestatītais izsekošanas ātrums."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोटांच्या त्याच हालचालीसाठी मजकूर किती दूर जातो. सिस्टमच्या ट्रॅकपॅडसाठी ठरवलेल्या ट्रॅकिंग गतीचेही हे पालन करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejauh mana kandungan bergerak untuk gerakan jari yang sama. Ia juga mengikut kelajuan penjejakan yang ditetapkan untuk pad jejak sistem."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor langt innholdet flytter seg ved samme fingerbevegelse. Det følger også sporingshastigheten som er angitt for systemets styreflate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe ver de inhoud beweegt bij dezelfde vingerbeweging. Dit volgt ook de volgsnelheid die voor de trackpad van het systeem is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ile przesuwa się zawartość przy takim samym ruchu palców. Uwzględnia też szybkość śledzenia ustawioną dla gładzika systemu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o conteúdo se move com o mesmo gesto dos dedos. Segue também a velocidade de rastreio definida para o trackpad do sistema."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o conteúdo se move com o mesmo gesto dos dedos. Também segue a velocidade de rastreamento definida para o trackpad do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât se mișcă conținutul pentru aceeași mișcare a degetelor. Urmează și viteza de urmărire setată pentru trackpadul sistemului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько смещается содержимое при том же движении пальцев. Также учитывается скорость отслеживания, заданная для трекпада системы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O koľko sa obsah posunie pri rovnakom pohybe prstov. Riadi sa aj rýchlosťou sledovania nastavenou pre trackpad v systéme."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako daleč se vsebina premakne ob enaki kretnji prstov. Upošteva tudi hitrost sledenja, nastavljeno za sledilno ploščico sistema."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колико се садржај помера при истом покрету прстију. Прати и брзину праћења подешену за трекпед система."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur långt innehållet flyttas för samma fingerrörelse. Det följer också den spårningshastighet som är inställd för systemets styrplatta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதே விரல் அசைவுக்கு உள்ளடக்கம் எவ்வளவு தூரம் நகரும். கணினியின் டிராக்பேடுக்கு அமைக்கப்பட்ட கண்காணிப்பு வேகத்தையும் இது பின்பற்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వేళ్ల అదే కదలికకు కంటెంట్ ఎంత దూరం కదులుతుంది. సిస్టమ్ ట్రాక్‌ప్యాడ్‌కు సెట్ చేసిన ట్రాకింగ్ వేగాన్ని కూడా ఇది అనుసరిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดว่าเนื้อหาเคลื่อนที่ไปไกลแค่ไหนต่อการเคลื่อนนิ้วเท่ากัน และยังเป็นไปตามความเร็วการติดตามที่ตั้งไว้สำหรับแทร็กแพดของระบบด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı parmak hareketinde içeriğin ne kadar gideceği. Sistemin izleme dörtgeni için ayarlanan izleme hızını da izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки зсувається вміст за того самого руху пальців. Також враховується швидкість відстеження, задана для трекпада системи."
          }
        },
        "ur-PK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انگلیوں کی اسی حرکت پر مواد کتنا آگے جاتا ہے۔ یہ سسٹم کے ٹریک پیڈ کے لیے مقرر کی گئی ٹریکنگ رفتار کی بھی پیروی کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung di chuyển bao xa cho cùng một chuyển động của các ngón tay. Cũng theo tốc độ theo dõi đã đặt cho bàn di chuột của hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同样的手指动作让内容移动多远。同时也会遵循系统触控板设置的跟踪速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相同的手指動作讓內容移動多遠。同時也會遵循系統軌跡板設定的追蹤速度。"
          }
        }
      }
    },
