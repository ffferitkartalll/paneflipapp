        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 會在你為它選擇的區域中開啟。區域內的 App 依此處顯示的順序出現在島上；拖曳把手即可更改順序。"
          }
        }
      }
    },
